@startuml 03-external-semantics
title MOEX External Semantics (LinkML moex-external-alignment + DAMS bridge)
hide empty members
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

note as N_SRC
  Normative source:
  moex-external-alignment.yaml (ADR-020).
  DAMS bridge uses ConceptualEntity / ModelPackage /
  LogicalEntity / Mapping from moex-core.
  ontology-application is a separate SpecImpl profile
  (OWL provider) — not a DAMS model level.
end note

package "External alignment" #F4CCCC {
  abstract class NamedAlignmentElement {
    +id : string [1]
    +title : string [0..1]
    +description : string [0..1]
  }

  class ExternalSpecification {
    +name : string [0..1]
    +specification_kind : ExternalSpecificationKind [0..1]
    +modeling_standard_ref : string [0..1]
  }
  class UpstreamLocator {
    +repository_url : uri [0..1]
    +release_ref : string [0..1]
    +license_url : uri [0..1]
  }
  class ExternalSpecificationVersion {
    +external_specification_ref : string [1]
    +release_ref : string [0..1]
    +specification_kind : ExternalSpecificationKind [0..1]
    +status : string [0..1]
  }

  class ExternalSpecificationScope {
    +external_specification_ref : string [1]
    +purpose : string [0..1]
    +status : string [0..1]
    +draft_only : boolean [0..1]
  }
  class ExternalSpecificationArea {
    +area_kind : ExternalSpecificationAreaKind [0..1]
    +code : string [0..1]
    +title : string [0..1]
    +relevance : string [0..1]
    +rationale : string [0..1]
  }

  class ExternalTermSelection {
    +version : string [0..1]
    +scope_ref : string [1]
    +status : string [0..1]
    +draft_only : boolean [0..1]
  }
  class CompetencyQuestion {
    +id : string [1]
    +question : string [0..1]
    +use_case : string [0..1]
    +status : string [0..1]
  }
  class ExternalTermReference {
    +upstream_iri : string [1]
    +term_kind : ExternalTermKind [1]
    +upstream_module_ref : string [0..1]
    +preferred_label : string [0..1]
  }
  class ExternalTermSelectionItem {
    +id : string [1]
    +local_concept_ref : string [0..1]
    +extraction_role : ExtractionRole [1]
    +decision : ExternalSelectionDecision [1]
    +supports : string [0..*]
    +review_status : ReviewStatus [1]
    +rationale : string [0..1]
  }
  class ExternalMappingAssertion {
    +id : string [1]
    +local_concept_ref : string [0..1]
    +upstream_iri : string [0..1]
    +relation : ExternalMappingRelation [0..1]
    +selection_item_ref : string [0..1]
    +review_status : ReviewStatus [0..1]
    +rationale : string [0..1]
  }
  class ExtractionPlan {
    +tool : string [0..1]
    +method : string [0..1]
    +source_version_ref : string [0..1]
    +seed_path : string [0..1]
    +output_path : string [0..1]
    +output_status : string [0..1]
  }
  class MaterializedExternalModule {
    +id : string [1]
    +path : string [0..1]
    +status : string [0..1]
    +content_hash : string [0..1]
    +extraction_plan_ref : string [0..1]
  }
}

package "DAMS bridge" #EADCF8 {
  class ConceptualEntity {
    +element_id : uriorcurie [1]
    +name : string [1]
  }
  class ModelPackage {
    +implementation_scope : ImplementationScopeEnum [0..1]
    +conceptual_implementation_ref : uriorcurie [0..1]
  }
  class LogicalEntity {
    +conceptual_entity_refs : ConceptualEntity [0..*]
    +conceptual_alignment_status : ConceptualAlignmentStatusEnum [0..1]
  }
  class Mapping {
    +mapping_type : MappingTypeEnum [1]
    +source_refs : uriorcurie [1..*]
    +target_refs : uriorcurie [1..*]
  }
}

NamedAlignmentElement <|-- ExternalSpecification
NamedAlignmentElement <|-- ExternalSpecificationVersion
NamedAlignmentElement <|-- ExternalSpecificationScope
NamedAlignmentElement <|-- ExternalTermSelection

ExternalSpecification "1" *-- "0..1" UpstreamLocator : upstream
ExternalSpecificationVersion "1" *-- "0..1" UpstreamLocator : upstream
ExternalSpecificationVersion "0..*" --> "1" ExternalSpecification : external_specification_ref

ExternalSpecification "1" o-- "0..*" ExternalSpecificationScope : scopes
ExternalSpecificationScope "1" *-- "0..*" ExternalSpecificationArea : included_areas
ExternalSpecificationScope "1" *-- "0..*" ExternalSpecificationArea : excluded_areas

ExternalSpecificationScope "1" <-- "0..*" ExternalTermSelection : scope_ref
ExternalTermSelection "1" *-- "1..*" CompetencyQuestion : competency_questions
ExternalTermSelection "1" *-- "0..*" ExternalTermSelectionItem : selected_terms
ExternalTermSelection "0..1" *-- "0..1" ExtractionPlan : extraction_plan
ExternalTermSelection "1" *-- "0..*" MaterializedExternalModule : materialized_modules
ExternalTermSelection "1" *-- "0..*" ExternalMappingAssertion : mappings

ExternalTermReference <|-- ExternalTermSelectionItem
ExternalTermSelectionItem "0..*" ..> CompetencyQuestion : supports\n(question ids)
ExternalMappingAssertion "0..*" --> "0..1" ExternalTermSelectionItem : selection_item_ref

ExternalTermSelectionItem "0..*" ..> ConceptualEntity : local_concept_ref
ExternalMappingAssertion "0..*" ..> ConceptualEntity : local_concept_ref

ModelPackage "0..*" --> "0..*" ConceptualEntity : conceptual_entities\n(enterprise scope)
ModelPackage "0..*" --> "0..1" ModelPackage : conceptual_implementation_ref\n(solution → enterprise)
ModelPackage "1" *-- "0..*" LogicalEntity : logical_entities
LogicalEntity "0..*" --> "0..*" ConceptualEntity : conceptual_entity_refs
Mapping "0..*" ..> LogicalEntity : realizes / aligns\n(via mapping_type + refs)
Mapping "0..*" ..> ConceptualEntity : realizes / aligns_with

note bottom of ExternalSpecificationScope
  Scope limits search interest.
  Included areas do not import a domain
  or select all upstream terms.
end note
note bottom of ExternalTermSelection
  Selection = managed term set with
  decisions, review, extraction_role,
  competency questions and mappings.
end note
note bottom of MaterializedExternalModule
  Technical extract dependency,
  not a MOEX ontology.
end note
note bottom of Mapping
  DAMS Mapping.mapping_type = aligns_with
  links enterprise conceptual to external term.
  mapping_type = realizes links solution
  logical to enterprise conceptual.
end note
@enduml
