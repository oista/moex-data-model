@startuml MOEX_DAMS_Metamodel
!theme plain
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam dpi 160

title MOEX DAMS v0.1 — метамодель (slim overview)\nLinkML-aligned: kernel + DAMS body + registries + external-alignment

note as N_SRC
  Illustrative overview. Normative sources:
  modeling-kernel.yaml,
  moex-dams / moex-core / moex-registries /
  moex-governance / moex-integration /
  moex-contract-binding / moex-analytics,
  moex-external-alignment.yaml
end note

' ===============================================================
' Modeling kernel (envelope — not DAMS is_a)
' ===============================================================

package "Modeling kernel" #E8F0FE {
  class ModelingStandard
  class ReferenceSpecification
  class SpecificationImplementation {
    +implementation_profile
    +dams_model_level
    +body_ref
  }
}

ModelingStandard "1" <-- "0..*" ReferenceSpecification : expressed_in
ReferenceSpecification "1" <-- "0..*" SpecificationImplementation : conforms_to

note bottom of SpecificationImplementation
  dams_model_level only for
  implementation_profile = dams-data-model:
  enterprise-conceptual | solution
end note

' ===============================================================
' DAMS ModelElement tree
' ===============================================================

package "DAMS ModelElement" #D9EAD3 {
  abstract class IdentifiedElement {
    +element_id [1]
  }
  abstract class ModelElement {
    +element_id [1]
    +name [1]
    +description [1]
    +lifecycle_status [1]
  }
  IdentifiedElement <|-- ModelElement

  class ModelPackage {
    +api_version [1]
    +model_version [1]
    +implementation_scope
  }
  class DomainContext
  class ConceptualEntity
  class LogicalEntity
  class LogicalAttribute
  class Relationship
  class TechnicalAsset
  class DataCarrier
  class DataStructure
  class SchemaNode
  class Mapping {
    +source_refs [1..*]
    +target_refs [1..*]
    +mapping_type [1]
    +mapping_cardinality [1]
  }
  class RealizesMapping
  class EntityPhysicalMapping
  class FieldMapping
  class AlignsWithMapping
  class DataFlow
  class DataFlowEntityBinding
  class DataModelBinding
  class ModelSelection
  class SelectedEntity
  class Metric
  class Dimension
}

ModelElement <|-- ModelPackage
ModelElement <|-- DomainContext
ModelElement <|-- ConceptualEntity
ModelElement <|-- LogicalEntity
ModelElement <|-- LogicalAttribute
ModelElement <|-- Relationship
ModelElement <|-- TechnicalAsset
TechnicalAsset <|-- DataCarrier
ModelElement <|-- DataStructure
IdentifiedElement <|-- Mapping
Mapping <|-- RealizesMapping
Mapping <|-- EntityPhysicalMapping
Mapping <|-- FieldMapping
Mapping <|-- AlignsWithMapping
ModelElement <|-- DataFlow
ModelElement <|-- DataFlowEntityBinding
ModelElement <|-- DataModelBinding
ModelElement <|-- ModelSelection
ModelElement <|-- SelectedEntity
ModelElement <|-- Metric
ModelElement <|-- Dimension

SpecificationImplementation ..> ModelPackage : body_ref

ModelPackage "1" *-- "0..*" ConceptualEntity : conceptual_entities
ModelPackage "1" *-- "0..*" DomainContext : domain_contexts
ModelPackage "1" *-- "0..*" LogicalEntity : logical_entities
ModelPackage "1" *-- "0..*" Relationship : relationships
ModelPackage "1" *-- "0..*" DataCarrier : data_carriers
ModelPackage "1" *-- "0..*" DataStructure : data_structures
ModelPackage "1" *-- "0..*" RealizesMapping : realizes_mappings
ModelPackage "1" *-- "0..*" EntityPhysicalMapping : entity_physical_mappings
ModelPackage "1" *-- "0..*" FieldMapping : field_mappings
ModelPackage "1" *-- "0..*" AlignsWithMapping : aligns_with_mappings

DomainContext "1" <-- "0..*" LogicalEntity : context_ref
LogicalEntity "1" *-- "0..*" LogicalAttribute : attributes
LogicalEntity "0..*" --> "0..*" ConceptualEntity : conceptual_entity_refs
Relationship "0..*" --> "1" LogicalEntity : source/target
DataCarrier "0..*" --> "0..1" DataStructure : structure_ref
DataStructure "1" *-- "0..*" SchemaNode : nodes

DataFlow "1" *-- "0..*" DataFlowEntityBinding : entity_bindings
DataModelBinding "1" *-- "1..*" ModelSelection : selections
ModelSelection "1" *-- "1..*" SelectedEntity : selected_entities
Metric "0..*" --> "1..*" LogicalEntity : grain_entity_refs

note right of ModelElement
  Backbone IdentifiedElement + mixins
  (ADR-044). Mapping is IdentifiedElement.
  Typed mapping collections (ADR-046).
  SchemaNode replaces PhysicalField (ADR-038).
end note

' ===============================================================
' RegistryEntry tree
' ===============================================================

package "Registries (RegistryEntry)" #FFF2CC {
  abstract class RegistryEntry {
    +registry_id [1]
    +registry_name [1]
    +registry_status [1]
  }
  class ITPlatform
  class ITSolution
  class ITSystem
  class BusinessDomain
  class GlossaryTerm
  class Policy
  class DataContractReference
  class IntegrationReference
  class Role
  class BusinessProcess
}

RegistryEntry <|-- ITPlatform
RegistryEntry <|-- ITSolution
RegistryEntry <|-- ITSystem
RegistryEntry <|-- BusinessDomain
RegistryEntry <|-- GlossaryTerm
RegistryEntry <|-- Policy
RegistryEntry <|-- DataContractReference
RegistryEntry <|-- IntegrationReference
RegistryEntry <|-- Role
RegistryEntry <|-- BusinessProcess

ITSolution "1" o-- "0..*" ITSystem : member_system_refs
ITSolution "0..*" --> "0..1" ITPlatform : platform_ref
TechnicalAsset "0..*" --> "1" ITSystem : system_ref
LogicalEntity "0..*" --> "0..1" ITSolution : solution_ref
ModelElement "0..*" --> "0..*" GlossaryTerm : glossary_term_refs

package "Governance objects" #D9D2E9 {
  abstract class GovernanceAssignment {
    +assignment_id [1]
    +target_element_ref [1]
    +assignment_scope [1]
  }
  class PolicyBinding {
    +policy_ref [1]
    +binding_effect [1]
  }
  class ClassificationAssignment
  class OwnershipAssignment
  GovernanceAssignment <|-- PolicyBinding
  GovernanceAssignment <|-- ClassificationAssignment
  GovernanceAssignment <|-- OwnershipAssignment
}

PolicyBinding "0..*" --> "1" Policy : policy_ref
GovernanceAssignment "0..*" --> "1" ModelElement : target_element_ref

' ===============================================================
' External alignment (separate schema)
' ===============================================================

package "External alignment" #F4CCCC {
  abstract class NamedAlignmentElement {
    +id [1]
  }
  class ExternalSpecification
  class ExternalSpecificationVersion
  class UpstreamLocator
  class ExternalSpecificationScope
  class ExternalTermSelection
  class ExternalTermSelectionItem
  class ExternalTermReference
  class ExternalMappingAssertion
  class CompetencyQuestion
  class MaterializedExternalModule
}

NamedAlignmentElement <|-- ExternalSpecification
NamedAlignmentElement <|-- ExternalSpecificationVersion
NamedAlignmentElement <|-- ExternalSpecificationScope
NamedAlignmentElement <|-- ExternalTermSelection
ExternalTermReference <|-- ExternalTermSelectionItem

ExternalSpecification "1" *-- "0..1" UpstreamLocator : upstream
ExternalSpecification "1" o-- "0..*" ExternalSpecificationScope : scopes
ExternalSpecificationScope "1" <-- "0..*" ExternalTermSelection : scope_ref
ExternalTermSelection "1" *-- "0..*" ExternalTermSelectionItem : selected_terms
ExternalTermSelection "1" *-- "1..*" CompetencyQuestion : competency_questions
ExternalTermSelection "1" *-- "0..*" ExternalMappingAssertion : mappings
ExternalTermSelection "1" *-- "0..*" MaterializedExternalModule : materialized_modules
ExternalMappingAssertion "0..*" ..> ConceptualEntity : local_concept_ref

' ===============================================================
' Repository root
' ===============================================================

package "Repository root" #FFFFFF {
  class MOEXModelRepository {
    +repository_id [1]
  }
}

MOEXModelRepository "1" *-- "0..*" RegistryEntry : registry_entries
MOEXModelRepository "1" *-- "0..*" ModelPackage : model_packages
MOEXModelRepository "1" *-- "0..*" DataFlow : data_flows
MOEXModelRepository "1" *-- "0..*" DataModelBinding : data_model_bindings
MOEXModelRepository "1" *-- "0..*" Metric : metrics
MOEXModelRepository "1" *-- "0..*" Dimension : dimensions
MOEXModelRepository "1" *-- "0..*" ClassificationAssignment : classification_assignments
MOEXModelRepository "1" *-- "0..*" PolicyBinding : policy_bindings

legend right
  <b>LinkML facts</b>

  Yellow: RegistryEntry (not ModelElement)
  Green: DAMS ModelElement body
  Blue: Modeling kernel envelope
  Red: External-alignment schema
  Purple: Governance objects

  <b>Key relations</b>
  conforms_to: SpecImpl → ReferenceSpecification
  realizes: Mapping.mapping_type
  entity_physical / field_mapping: Mapping
  aligns_with: Mapping or ExternalMappingAssertion
endlegend

@enduml
