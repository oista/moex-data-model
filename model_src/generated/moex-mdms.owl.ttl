            owl:maxCardinality 1 ;
            owl:onProperty mdms:approved_by_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:ApprovalStatusEnum ;
            owl:onProperty mdms:approval_status ] ;
