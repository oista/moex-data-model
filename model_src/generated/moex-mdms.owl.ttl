mdms:MOEXModelRepository a owl:Class ;
    rdfs:label "MOEXModelRepository" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom mdms:ModelPackage ;
            owl:onProperty mdms:model_packages ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:model_packages ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:DataModelBinding ;
            owl:onProperty mdms:data_model_bindings ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty mdms:repository_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:data_model_bindings ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:RegistryEntry ;
            owl:onProperty mdms:registry_entries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:classification_assignments ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:ClassificationAssignment ;
            owl:onProperty mdms:classification_assignments ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:Metric ;
            owl:onProperty mdms:metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:PolicyBinding ;
            owl:onProperty mdms:policy_bindings ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mdms:repository_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty mdms:repository_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:registry_entries ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:data_flows ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:dimensions ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:DataFlow ;
            owl:onProperty mdms:data_flows ],
        [ a owl:Restriction ;
            owl:allValuesFrom mdms:Dimension ;
            owl:onProperty mdms:dimensions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:policy_bindings ] ;
    skos:definition "Корневой контейнер для проверки набора моделей, ссылочных проекций справочников, потоков и контрактных bindings." ;
    skos:inScheme mdms:v0.1 .

mdms:v0.1.owl.ttl a owl:Ontology ;
    rdfs:label "moex_mdms" ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0" ;
    pav:version "0.1.0" .

mdms:HasProvenance a owl:Class ;
    rdfs:label "HasProvenance" ;
