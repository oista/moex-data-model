            owl:onProperty mdms:approved_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty mdms:source_artifact_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty mdms:approved_at ],
        [ a owl:Restriction ;
