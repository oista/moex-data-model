# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Package outputs
packages/ontology/output/
**/output/

# Staged release bundle tree (index manifest under generated/manifests/ is committed)
generated/bundles/

# gen-doc full tree is regenerable; only index + policy README are tracked (P3)
generated/artifacts/moex-dams/0.1/docs/*
!generated/artifacts/moex-dams/0.1/docs/index.md
!generated/artifacts/moex-dams/0.1/docs/README.md

# Local FIBO clone (do not commit upstream sources).
# Use anchored paths so Python packages named fibo/ are not ignored.
/fibo/
/packages/ontology/fibo/

# External source sync caches (ROBOT JAR, mirrored releases)
.cache/
model-assets/external-sources/**/.cache/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
