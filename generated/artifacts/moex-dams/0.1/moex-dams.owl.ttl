    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:PhysicalField a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PhysicalField" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:native_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:ordinal_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:schema_path ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:native_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:ordinal_position ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:mapping_coverage_status ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:physical_object_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:mapping_rationale ],
        dams:HasGovernanceClassification,
        dams:HasOwnership,
        dams:HasPolicyBindings,
        dams:ModelElement ;
    skos:definition "Поле физического объекта; его семантика задаётся Mapping к LogicalAttribute." ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:RelationTerm a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RelationTerm" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:default_relationship_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:ontology_property_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:forward_label_en ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:forward_label ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:inverse_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:inverse_label_en ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:symmetric ],
        dams:HasDefinition,
        dams:ModelElement ;
    skos:definition """Governed dictionary term for a conceptual/logical relationship (ADR-026). Provides forward and inverse natural-language labels so a single Relationship assertion can be read from either side.
""" ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:SemVer a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf linkml:String .

dams:SpecificationRequirement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SpecificationRequirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dams:formal_checks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:implementation_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:applies_to ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:requirement_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:superseded_by ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:statement ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:code ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:String [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^(LDM|PDM|REF|ATR|FLW|CLS|GEN)-[0-9]{3}$" ] ) ] ) ] ;
            owl:onProperty dams:code ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:requirement_section ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:lifecycle_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom dams:RequirementLifecycleStatus ;
            owl:onProperty dams:lifecycle_status ],
        dams:ModelElement ;
    skos:definition "Нормативное требование к модели, соответствующей reference specification (каталог для уровня ИТ-решения и др.)." ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

