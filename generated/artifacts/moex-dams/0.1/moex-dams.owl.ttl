dams:AccessPoint a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AccessPoint" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:asset_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom dams:AccessPointKindEnum ;
            owl:onProperty dams:asset_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:http_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty dams:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:path_template ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:operation_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:interface_ref ],
        dams:HasLocation,
        dams:HasProtocolBinding,
        dams:TechnicalAsset ;
    skos:definition """Точка доступа к данным: интерфейс, операция или канал. Сама данные не несёт; указывает на носители через serves_refs.
""" ;
    skos:inScheme <https://data.moex.com/dams/technical/v0.1> .

dams:CheckSeverityEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "CheckSeverityEnum" ;
    owl:unionOf ( <https://data.moex.com/dams/CheckSeverityEnum#error> <https://data.moex.com/dams/CheckSeverityEnum#warning> ) ;
    skos:inScheme <https://data.moex.com/dams/types/v0.1> ;
    linkml:permissible_values <https://data.moex.com/dams/CheckSeverityEnum#error>,
        <https://data.moex.com/dams/CheckSeverityEnum#warning> .

dams:ConceptualDomainKindEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ConceptualDomainKindEnum" ;
    owl:unionOf ( <https://data.moex.com/dams/ConceptualDomainKindEnum#enumerated> <https://data.moex.com/dams/ConceptualDomainKindEnum#described> ) ;
    skos:definition "Вид концептуального домена (ISO 11179 Conceptual Domain)." ;
    skos:inScheme <https://data.moex.com/dams/types/v0.1> ;
    linkml:permissible_values <https://data.moex.com/dams/ConceptualDomainKindEnum#described>,
        <https://data.moex.com/dams/ConceptualDomainKindEnum#enumerated> .

dams:ConceptualProperty a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ConceptualProperty" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:conceptual_domain_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:significance_rationale ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dams:significance_basis ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:is_identifying ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:property_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:genesis_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:property_owner_entity_ref ],
        dams:HasDefinition,
        dams:HasOwnership,
        dams:HasPolicyBindings,
        dams:HasProvenance,
        dams:ModelElement ;
    owl:hasKey ( dams:property_owner_entity_ref dams:name ) ;
    skos:closeMatch rdf:Property ;
    skos:definition """Значимое концептуальное свойство сущности КМД. Создаётся только при наличии significance_basis; не обязательно для каждого LogicalAttribute.
""" ;
    skos:exactMatch dams:ConceptualProperty ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> ;
    skos:note """ISO/IEC 11179 Property (close). Облегчённый концептуальный слой — только для значимых атрибутов (вариант B, ADR-034). IRI ISO 11179 не используются.
""" .

dams:DAMSModelLevelEnum a owl:Class,
