dams:ConceptualDomain a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ConceptualDomain" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:conceptual_domain_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:concept_scheme_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:broader_domain_ref ],
        dams:HasOwnership,
        dams:HasProvenance,
        dams:ModelElement ;
    skos:closeMatch skos:ConceptScheme ;
    skos:definition """Концептуальный домен значений: набор смыслов (ValueMeaning) или ссылка на внешнюю схему понятий. Допустим только в пакетах implementation_scope=enterprise.
""" ;
    skos:exactMatch dams:ConceptualDomain ;
    skos:inScheme <https://data.moex.com/dams/semantic/v0.1> ;
    skos:note """ISO/IEC 11179 Conceptual Domain — набор value meanings (смыслов значений). IRI ISO 11179 не опубликованы стабильно; соответствие фиксируется в ADR-035. SKOS: ConceptScheme (не Collection) — чтобы допускать семантические связи между ValueMeaning (skos:Concept).
""" .

