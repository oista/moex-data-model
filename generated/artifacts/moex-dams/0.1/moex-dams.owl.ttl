dams:DataContainer a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataContainer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:direction ],
        [ a owl:Restriction ;
            owl:allValuesFrom dams:DataContainerKindEnum ;
            owl:onProperty dams:asset_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:asset_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty dams:direction ],
        dams:Contains,
        dams:TechnicalAsset ;
    skos:definition """Контейнер других активов (database, schema, bucket, broker, directory, cluster). Данных не несёт: structure_ref и data_format отсутствуют.
""" ;
