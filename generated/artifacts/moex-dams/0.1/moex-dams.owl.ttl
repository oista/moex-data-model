dams:Mapping a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Mapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Decimal [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:confidence ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:mapping_cardinality ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dams:source_refs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:transformation_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:transformation_expression ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_from ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dams:target_refs ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:mapping_type ],
        dams:HasProvenance,
        dams:ModelElement ;
    skos:definition """Явное соответствие между элементами. Discriminate via mapping_type: realizes (solution→enterprise conceptual), entity_physical (DataCarrier↔LogicalEntity), field_mapping/mapsTo (PhysicalField↔LogicalAttribute), aligns_with (enterprise↔external term). Not used for SpecImpl implements/conforms_to.
""" ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

