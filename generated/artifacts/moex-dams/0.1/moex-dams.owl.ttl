dams:Relationship a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Relationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:associative ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:cardinality_rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_min_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:source_min_cardinality ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_entity_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:source_max_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:source_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:source_max_cardinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:source_min_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:relationship_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:target_min_cardinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:target_max_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:relation_term_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:target_entity_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_max_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:identifying ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:term_direction ],
        dams:ModelElement ;
    skos:definition "Именованная связь между логическими или концептуальными сущностями." ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

