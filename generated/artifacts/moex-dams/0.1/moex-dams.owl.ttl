dams:DataFlow a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataFlow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_platform_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:target_solution_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:target_platform_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_solution_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integration_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:contract_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_system_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integration_spec_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integration_channel ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integration_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:target_system_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integration_level ],
        dams:HasLifecycle,
        dams:HasOwnership,
        dams:ModelElement ;
    skos:definition "Ссылочная проекция зарегистрированной интеграции; топология и канал являются данными Clinkr, а семантика — модели данных." ;
    skos:inScheme <https://data.moex.com/dams/integration/v0.1> .

dams:DefinitionScopeKindEnum a owl:Class,
