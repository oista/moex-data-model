        linkml:SlotDefinition ;
    rdfs:label "serves_refs" ;
    rdfs:range dams:DataCarrier ;
    skos:definition "Носители, доступные через эту точку доступа." ;
    skos:inScheme <https://data.moex.com/dams/technical/v0.1> .

dams:source_nodes a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_nodes" ;
    rdfs:range linkml:Uriorcurie ;
    skos:definition "Стартовые узлы reachable_from." ;
    skos:inScheme <https://data.moex.com/dams/datatypes/v0.1> .

dams:tags a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "tags" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

