    rdfs:label "scoped_definitions" ;
    rdfs:range dams:ScopedDefinition ;
    skos:definition "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:sensitivity_term_refs a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "sensitivity_term_refs" ;
    rdfs:range dams:DataClassificationTerm ;
