        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:native_schema_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:technology ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:object_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:solution_ref ],
