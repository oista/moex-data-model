dams:ModelPackage a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ModelPackage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:model_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:implementation_scope ],
