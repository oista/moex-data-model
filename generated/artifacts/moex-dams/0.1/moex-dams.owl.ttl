        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:cardinality_rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:source_max_cardinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
