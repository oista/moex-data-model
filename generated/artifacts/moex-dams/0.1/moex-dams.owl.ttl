dams:ValueDomain a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ValueDomain" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:max_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:min_value ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:data_type_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:value_domain_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:unit_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:dynamic_query ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:conceptual_domain_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:value_set_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:format_pattern ],
        dams:ModelElement ;
    skos:definition """Представление значений: тип, формат, единица, допустимые значения или ссылка на внешний набор. Допустим в пакетах enterprise и solution.
""" ;
