""" ;
    skos:inScheme <https://data.moex.com/dams/types/v0.1> ;
    linkml:permissible_values <https://data.moex.com/dams/DefinitionScopeKindEnum#system> .

dams:DomainContext a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DomainContext" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:namespace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:solution_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:domain_ref ],
        dams:HasOwnership,
        dams:ModelElement ;
