[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:type_family ;
            owl:someValuesFrom linkml:String ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:min_length ;
                owl:someValuesFrom linkml:String ] dams:DataType ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:type_family ;
            owl:someValuesFrom linkml:String ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:scale ;
                owl:someValuesFrom linkml:String ] dams:DataType ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:permissible_values ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:value_domain_kind ;
                owl:someValuesFrom linkml:String ] dams:ValueDomain ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:permissible_values ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:value_domain_kind ;
                owl:someValuesFrom linkml:String ] dams:ValueDomain ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:type_family ;
            owl:someValuesFrom linkml:String ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:precision ;
                owl:someValuesFrom linkml:String ] dams:DataType ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty dams:http_method ;
                        owl:someValuesFrom linkml:String ] [ a owl:Restriction ;
                        owl:onProperty dams:operation_name ;
                        owl:someValuesFrom linkml:String ] [ a owl:Restriction ;
                        owl:onProperty dams:path_template ;
                        owl:someValuesFrom linkml:String ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:asset_kind ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "interface" ] ) ] ] dams:AccessPoint ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:interface_ref ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:asset_kind ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "operation" ] ) ] ] dams:AccessPoint ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:type_family ;
            owl:someValuesFrom linkml:String ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:max_length ;
                owl:someValuesFrom linkml:String ] dams:DataType ) .

[] rdfs:subClassOf [ owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty dams:location_uri ;
                        owl:someValuesFrom linkml:String ] [ a owl:Restriction ;
                        owl:onProperty dams:region ;
                        owl:someValuesFrom linkml:String ] ) ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:asset_kind ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "in_memory" ] ) ] ] dams:DataCarrier ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:permissible_values ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:value_domain_kind ;
                owl:someValuesFrom linkml:String ] dams:ValueDomain ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:value_meanings ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:conceptual_domain_kind ;
                owl:someValuesFrom linkml:String ] dams:ConceptualDomain ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty dams:is_identifying ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "true" ] ) ] ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty dams:property_kind ;
                owl:someValuesFrom linkml:String ] dams:ConceptualProperty ) .

