                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:target_min_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:source_min_cardinality ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:source_min_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:associative ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_entity_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:identifying ],
        [ a owl:Restriction ;
