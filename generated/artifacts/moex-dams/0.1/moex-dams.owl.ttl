    skos:inScheme <https://data.moex.com/dams/registries/v0.1> .

dams:HasDefinition a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "HasDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:definition_rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:definition_source_ref ] ;
    skos:definition """Mixin эталонного определения (ADR-025). Слот description остаётся skos:definition (own text). Отсутствие description при наличии definition_source_ref означает наследование; заданный description — own (опционально adapted from source). scoped_definitions — контекстные определения (v1: уровень ITSystem), не заменяющие эталон вне scope.
""" ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:ITPlatform a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ITPlatform" ;
