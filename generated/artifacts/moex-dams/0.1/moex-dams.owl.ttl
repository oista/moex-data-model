            owl:maxCardinality 1 ;
            owl:onProperty dams:critical_data_element ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:mapping_rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:concept_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:multivalued ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:currency_attribute_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:value_set_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:timezone_policy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:minimum_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:format_pattern ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:logical_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:default_value ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:owner_entity_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:temporal_semantics ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:required ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:maximum_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:minimum_cardinality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:value_domain_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:data_type_ref ],
        dams:HasDefinition,
        dams:HasGovernanceClassification,
        dams:HasOwnership,
        dams:HasPolicyBindings,
        dams:ModelElement ;
    skos:definition """Логический атрибут сущности: идентификация, обязательность, кардинальность и ссылки на представление (DataType/ValueDomain) и опционально на ConceptualProperty (вариант B, ADR-034).
""" ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

