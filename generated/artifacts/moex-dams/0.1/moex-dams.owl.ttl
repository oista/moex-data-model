        linkml:SlotDefinition ;
    rdfs:label "relation_terms" ;
    rdfs:range dams:RelationTerm ;
    skos:definition "Governed relation-term dictionary for the package (ADR-026)." ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:relationship_types a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "relationship_types" ;
    rdfs:range linkml:Uriorcurie ;
    skos:definition "Типы связей для обхода." ;
    skos:inScheme <https://data.moex.com/dams/datatypes/v0.1> .

