dams:ClassificationAssignment a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ClassificationAssignment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:assignment_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:classification_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:governance_classification ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:classified_element_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:classification_term_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approval_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:classification_rationale ] ;
    skos:definition "Версионируемое назначение категории классификации элементу модели с основанием и периодом действия." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

<https://data.moex.com/dams/DefinitionScopeKindEnum#system> a owl:Class,
        dams:DefinitionScopeKindEnum ;
    rdfs:label "system" ;
    rdfs:subClassOf dams:DefinitionScopeKindEnum ;
    skos:definition "Definition applies within one ITSystem of the solution." .

dams:ExternalClassRef a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ExternalClassRef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:external_specification_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:selection_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:target_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:match_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:external_class_ref_id ],
        dams:HasProvenance ;
    skos:definition """Alignment of a ConceptualEntity to an external class or term (ADR-026). Canonical store for conceptual↔external links; Mapping(aligns_with) may mirror for ExternalTermSelection projections.
""" ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:FormalCheck a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FormalCheck" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:remediation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_path ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:check_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:expression ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:severity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_slot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:diagnostic_code ] ;
    skos:definition "Одна машиночитаемая проверка требования. Kind выровнен с LinkML constraints и DAMS reference/structural diagnostics. formal_checks — исполняемое подмножество нормы; исполняется assess (ADR-013)." ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

dams:PolicyBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PolicyBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_to ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:policy_binding_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_from ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:policy_target_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approval_status ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:policy_ref ] ;
    skos:definition "Применение управляемой политики к элементу модели." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:RequirementApplicability a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RequirementApplicability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:applies_target_class ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:applies_dams_model_level ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:applies_implementation_profile ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:applicability_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:applies_implementation_scope ] ;
    skos:definition """Область применимости требования (без graph queries): класс цели, профиль и уровень модели.
""" ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

dams:ScopedDefinition a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ScopedDefinition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:scope_kind ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:relation_to_reference ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:rationale ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:scope_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:scoped_definition_id ],
        dams:HasProvenance ;
    skos:definition """Контекстное определение элемента модели (ADR-025 / ISO 11179 Context). Не является отдельным термином глоссария и не заменяет эталонное определение вне указанного scope.
""" ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

