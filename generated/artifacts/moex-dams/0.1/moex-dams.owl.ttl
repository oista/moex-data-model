    rdfs:label "applies_target_kinds" ;
    rdfs:range linkml:String ;
    skos:definition "Опциональный allowlist asset_kind / facet (например relational_table, stream_topic)." ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

