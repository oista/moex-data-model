dams:DataFlowEntityBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataFlowEntityBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dams:logical_attribute_refs ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:direction ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:flow_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_model_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dams:physical_object_refs ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:logical_entity_ref ],
        dams:ModelElement ;
    skos:definition "Связь потока с логическими сущностями, атрибутами и физическими объектами модели решения." ;
    skos:inScheme <https://data.moex.com/dams/integration/v0.1> .

dams:DataModelBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataModelBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:model_package_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:model_version ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integrity_digest ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:integration_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:model_revision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:compatibility_baseline_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:specification_version ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:implementation_version ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:compatibility_mode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:contract_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:generated_at ],
