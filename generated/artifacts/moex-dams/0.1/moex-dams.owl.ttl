dams:ValueMeaning a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ValueMeaning" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:meaning_definition ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:meaning_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:meaning_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:broader_meaning_key ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:meaning_term_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:meaning_label ] ;
    skos:definition """Смысл допустимого значения внутри ConceptualDomain (встраиваемый, без lifecycle).
""" ;
    skos:exactMatch skos:Concept,
        dams:ValueMeaning ;
    skos:inScheme <https://data.moex.com/dams/semantic/v0.1> ;
    skos:note "ISO/IEC 11179 Value Meaning; IRI ISO не используются (ADR-035)." .

dams:ValueSetQuery a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ValueSetQuery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:include_self ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:source_ontology ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:value_set_query_id ] ;
    skos:definition """Динамический запрос набора значений по образцу LinkML reachable_from (source ontology, узлы, типы связей).
""" ;
    skos:exactMatch dams:ValueSetQuery ;
    skos:inScheme <https://data.moex.com/dams/datatypes/v0.1> .

dams:asset_namespace a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asset_namespace" ;
    rdfs:range linkml:String ;
    skos:definition """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
    skos:inScheme <https://data.moex.com/dams/technical/v0.1> .

