dams:ModelElement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ModelElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:element_id ],
        [ owl:unionOf ( dams:ConceptualDomain dams:ConceptualEntity dams:ConceptualProperty dams:DataFlow dams:DataFlowEntityBinding dams:DataModelBinding dams:DataType dams:Dimension dams:DomainContext dams:LogicalAttribute dams:LogicalEntity dams:Mapping dams:Metric dams:ModelPackage dams:ModelSelection dams:PhysicalField dams:RelationTerm dams:Relationship dams:SelectedAttribute dams:SelectedEntity dams:SpecificationRequirement dams:TechnicalAsset dams:ValueDomain ) ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:description ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:title ],
        dams:HasLifecycle ;
    skos:definition "Абстрактный корень иерархии элементов модели: общая идентичность (element_id), имя, описание и жизненный цикл." ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

