            owl:cardinality 1 ;
            owl:onProperty dams:system_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:qualified_name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:direction ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:mapping_coverage_status ],
        dams:HasGovernanceClassification,
        dams:HasOwnership,
        dams:HasPolicyBindings,
        dams:ModelElement ;
    skos:definition "Квант данных или техническая точка публикации/потребления." ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

