dams:external_class_refs a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "external_class_refs" ;
    rdfs:range dams:ExternalClassRef ;
    skos:definition """Canonical ConceptualEntity → external class/term alignments with match_kind (ADR-026). Non-empty iff genesis_kind=external.
""" ;
