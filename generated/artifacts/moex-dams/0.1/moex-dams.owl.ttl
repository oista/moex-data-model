dams:DataType a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:min_length ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:max_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:linkml_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:base_type_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:scale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:charset ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:type_family ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:max_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:datatype_timezone_policy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:xsd_datatype ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:min_length ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:precision ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:type_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] ) ] ;
            owl:onProperty dams:scale ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:precision ],
        dams:ModelElement ;
    owl:hasKey ( dams:type_name ) ;
    skos:closeMatch rdfs:Datatype ;
    skos:definition """Корпоративный тип данных: семейство, параметры представления и соответствие XSD/LinkML. Допустим только в корпоративном реестре типов.
""" ;
    skos:exactMatch dams:DataType ;
    skos:inScheme <https://data.moex.com/dams/datatypes/v0.1> ;
    skos:note "ISO/IEC 11179 Datatype; корпоративный реестр логических типов (ADR-036)." .

