        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:deprecated_by_ref ] ;
    skos:definition "Mixin жизненного цикла: статус, период действия и ссылка на заменяющий элемент." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:PhysicalField a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PhysicalField" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:mapping_coverage_status ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:native_name ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:native_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty dams:ordinal_position ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:carrier_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:required ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:ordinal_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:schema_path ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:mapping_rationale ],
        dams:HasGovernanceClassification,
        dams:HasOwnership,
        dams:HasPolicyBindings,
        dams:ModelElement ;
    skos:definition """Поле носителя данных (DataCarrier); семантика задаётся Mapping к LogicalAttribute.
""" ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:RelationTerm a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RelationTerm" ;
