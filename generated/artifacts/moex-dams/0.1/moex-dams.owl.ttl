""" ;
    skos:inScheme <https://data.moex.com/dams/types/v0.1> ;
    linkml:permissible_values <https://data.moex.com/dams/DefinitionScopeKindEnum#system> .

dams:DomainContext a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DomainContext" ;
