@prefix dams: <https://data.moex.com/dams/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dams:MOEXModelRepository a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "MOEXModelRepository" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:repository_id ] ;
    skos:definition "Корневой контейнер для проверки набора моделей, ссылочных проекций справочников, потоков и контрактных bindings." ;
    skos:inScheme dams:v0.1 .

dams:RequirementCatalog a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RequirementCatalog" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:catalog_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:name ] ;
    skos:definition "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

dams:access_points a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "access_points" ;
    rdfs:range dams:AccessPoint ;
    skos:definition "Коллекция точек доступа пакета (Variant B, ADR-031)." ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:aliases a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "aliases" ;
    rdfs:range linkml:String ;
    skos:inScheme <https://data.moex.com/dams/core/v0.1> .

dams:applies_target_kinds a owl:ObjectProperty,
