}

Table RequirementCatalog {
catalog_id varchar [not null, primary key]
name varchar [not null]
requirements varchar
}

Table MOEXModelRepository {
repository_id varchar [not null, primary key]
registry_entries varchar
model_packages varchar
data_flows varchar
data_model_bindings varchar
metrics varchar
dimensions varchar
classification_assignments varchar
policy_bindings varchar
}

