@prefix dams: <https://data.moex.com/dams/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a linkml:SchemaDefinition ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0" ;
    pav:version "0.1.0" ;
    sh:declare [ sh:namespace "https://data.moex.com/dams/"^^xsd:anyURI ;
            sh:prefix "dams" ],
        [ sh:namespace "https://data.moex.com/"^^xsd:anyURI ;
            sh:prefix "moex" ],
        [ sh:namespace "https://w3id.org/linkml/"^^xsd:anyURI ;
            sh:prefix "linkml" ] ;
    dams:name "moex_dams" ;
    linkml:classes [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Абстрактный корень иерархии элементов модели: общая идентичность (element_id), имя, описание и жизненный цикл." ;
            dams:name "ModelElement" ;
            linkml:abstract true ;
            linkml:class_uri "https://data.moex.com/dams/ModelElement"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ModelElement"^^xsd:anyURI ;
            linkml:mixins dams:HasLifecycle ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:name,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Ограниченный логический контекст с собственной терминологией и областью ответственности." ;
            dams:name "DomainContext" ;
            linkml:class_uri "https://data.moex.com/dams/DomainContext"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/DomainContext"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasOwnership ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:business_process_refs,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:domain_ref,
                dams:element_id,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:name,
                dams:namespace,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:solution_ref,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Квант данных или техническая точка публикации/потребления." ;
            dams:name "PhysicalObject" ;
            linkml:class_uri "https://data.moex.com/dams/PhysicalObject"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/PhysicalObject"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasGovernanceClassification,
                dams:HasOwnership,
                dams:HasPolicyBindings ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:classification_rationale,
                dams:classification_source,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:direction,
                dams:element_id,
                dams:glossary_term_refs,
                dams:governance_classification,
                dams:lifecycle_status,
                dams:mapping_coverage_status,
                dams:mapping_rationale,
                dams:name,
                dams:native_schema_ref,
                dams:object_kind,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:physical_fields,
                dams:policy_refs,
                dams:qualified_name,
                dams:security_classification,
                dams:sensitivity_term_refs,
                dams:solution_ref,
                dams:system_ref,
                dams:tags,
                dams:technology,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Логический атрибут сущности с бизнес-смыслом, типом, обязательностью и классификацией." ;
            dams:name "LogicalAttribute" ;
            linkml:class_uri "https://data.moex.com/dams/LogicalAttribute"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/LogicalAttribute"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasDefinition,
                dams:HasGovernanceClassification,
                dams:HasOwnership,
                dams:HasPolicyBindings ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:LogicalAttribute_description,
                dams:aliases,
                dams:classification_rationale,
                dams:classification_source,
                dams:currency_attribute_ref,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:default_value,
                dams:definition_rationale,
                dams:definition_source_ref,
                dams:deprecated_by_ref,
                dams:derived_expression,
                dams:element_id,
                dams:format_pattern,
                dams:glossary_term_refs,
                dams:governance_classification,
                dams:lifecycle_status,
                dams:logical_type,
                dams:mapping_coverage_status,
                dams:mapping_rationale,
                dams:maximum_cardinality,
                dams:minimum_cardinality,
                dams:multivalued,
                dams:name,
                dams:owner_entity_ref,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:policy_refs,
                dams:required,
                dams:scoped_definitions,
                dams:security_classification,
                dams:sensitivity_term_refs,
                dams:tags,
                dams:temporal_semantics,
                dams:timezone_policy,
                dams:title,
                dams:unit_code,
                dams:valid_from,
                dams:valid_to,
                dams:value_set_ref ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/analytics/v0.1"^^xsd:anyURI ;
            dams:description "Переиспользуемое аналитическое измерение, связанное с логическими атрибутами." ;
            dams:name "Dimension" ;
            linkml:class_uri "https://data.moex.com/dams/Dimension"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/Dimension"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:dimension_attribute_refs,
                dams:element_id,
                dams:glossary_term_refs,
                dams:grain_entity_refs,
                dams:lifecycle_status,
                dams:name,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Представление бизнес-сущности в доменном контексте и модели конкретного решения." ;
            dams:name "LogicalEntity" ;
            linkml:class_uri "https://data.moex.com/dams/LogicalEntity"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/LogicalEntity"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasBusinessClassification,
                dams:HasDefinition,
                dams:HasGovernanceClassification,
                dams:HasOwnership,
                dams:HasPolicyBindings ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:LogicalEntity_description,
                dams:aliases,
                dams:alignment_rationale,
                dams:attributes,
                dams:business_importance,
                dams:business_key_kind,
                dams:classification_rationale,
                dams:classification_source,
                dams:conceptual_alignment_status,
                dams:conceptual_entity_refs,
                dams:context_ref,
                dams:data_class,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:definition_rationale,
                dams:definition_source_ref,
                dams:deprecated_by_ref,
                dams:element_id,
                dams:entity_type,
                dams:glossary_term_refs,
                dams:governance_classification,
                dams:identity_rule,
                dams:invariant_refs,
                dams:isolation_rationale,
                dams:key_attribute_refs,
                dams:lifecycle_status,
                dams:name,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:policy_refs,
                dams:scoped_definitions,
                dams:security_classification,
                dams:sensitivity_term_refs,
                dams:solution_data_role,
                dams:solution_ref,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/requirements/v0.1"^^xsd:anyURI ;
            dams:description "Одна машиночитаемая проверка требования. Kind выровнен с LinkML constraints и DAMS reference/structural diagnostics. formal_checks — исполняемое подмножество нормы; исполняется assess (ADR-013)." ;
            dams:name "FormalCheck" ;
            linkml:class_uri "https://data.moex.com/dams/FormalCheck"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/FormalCheck"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:check_id,
                dams:diagnostic_code,
                dams:expression,
                dams:kind,
                dams:remediation,
                dams:severity,
                dams:target_class,
                dams:target_path,
                dams:target_slot,
                dams:target_slots ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Корпоративное бизнес-понятие верхнего уровня, независимое от конкретной реализации." ;
            dams:name "ConceptualEntity" ;
            linkml:class_uri "https://data.moex.com/dams/ConceptualEntity"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ConceptualEntity"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasBusinessClassification,
                dams:HasDefinition,
                dams:HasOwnership ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:ConceptualEntity_description,
                dams:aliases,
                dams:business_importance,
                dams:data_class,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:definition_rationale,
                dams:definition_source_ref,
                dams:deprecated_by_ref,
                dams:element_id,
                dams:entity_type,
                dams:glossary_term_refs,
                dams:key_attribute_refs,
                dams:lifecycle_status,
                dams:name,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:parent_concept_ref,
                dams:scoped_definitions,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description """Версионируемый артефакт модели данных: либо корпоративная conceptual модель (enterprise), либо модель конкретного ИТ-решения (solution). Package-level DAMS layer is dams_model_level on the SpecImpl envelope (ADR-021); implementation_scope here mirrors that body-level semantics.
""" ;
            dams:name "ModelPackage" ;
            linkml:class_uri "https://data.moex.com/dams/ModelPackage"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ModelPackage"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasGovernanceClassification,
                dams:HasOwnership,
                dams:HasPolicyBindings ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:api_version,
                dams:classification_rationale,
                dams:classification_source,
                dams:conceptual_entities,
                dams:conceptual_implementation_ref,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:domain_contexts,
                dams:domain_refs,
                dams:element_id,
                dams:glossary_term_refs,
                dams:governance_classification,
                dams:implementation_scope,
                dams:imports_refs,
                dams:lifecycle_status,
                dams:logical_entities,
                dams:mappings,
                dams:model_version,
                dams:name,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:physical_objects,
                dams:policy_refs,
                dams:relationships,
                dams:security_classification,
                dams:sensitivity_term_refs,
                dams:solution_ref,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/contract-binding/v0.1"^^xsd:anyURI ;
            dams:description "Переиспользуемый набор выбранных сущностей, атрибутов и физических представлений." ;
            dams:name "ModelSelection" ;
            linkml:class_uri "https://data.moex.com/dams/ModelSelection"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ModelSelection"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:name,
                dams:selected_entities,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/integration/v0.1"^^xsd:anyURI ;
            dams:description "Связь потока с логическими сущностями, атрибутами и физическими объектами модели решения." ;
            dams:name "DataFlowEntityBinding" ;
            linkml:class_uri "https://data.moex.com/dams/DataFlowEntityBinding"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/DataFlowEntityBinding"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:direction,
                dams:element_id,
                dams:flow_ref,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:logical_attribute_refs,
                dams:logical_entity_ref,
                dams:name,
                dams:physical_field_refs,
                dams:physical_object_refs,
                dams:source_model_ref,
                dams:tags,
                dams:title,
                dams:transformation_mapping_refs,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/governance/v0.1"^^xsd:anyURI ;
            dams:description """Базовая и специальная классификация чувствительности данных. governance_classification участвует в containment cascade (ADR-023): пустой слот наследуется от родителя, заданный — override.
""" ;
            dams:name "HasGovernanceClassification" ;
            linkml:class_uri "https://data.moex.com/dams/HasGovernanceClassification"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/HasGovernanceClassification"^^xsd:anyURI ;
            linkml:mixin true ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:classification_rationale,
                dams:classification_source,
                dams:governance_classification,
                dams:security_classification,
                dams:sensitivity_term_refs ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/contract-binding/v0.1"^^xsd:anyURI ;
            dams:description "Дочерняя модельная спецификация дата-контракта, фиксирующая неизменяемую ревизию модели и передаваемый срез." ;
            dams:name "DataModelBinding" ;
            linkml:class_uri "https://data.moex.com/dams/DataModelBinding"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/DataModelBinding"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasLifecycle,
                dams:HasOwnership ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:compatibility_baseline_ref,
                dams:compatibility_mode,
                dams:contract_ref,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:generated_at,
                dams:glossary_term_refs,
                dams:implementation_version,
                dams:integration_ref,
                dams:integrity_digest,
                dams:lifecycle_status,
                dams:model_package_ref,
                dams:model_revision,
                dams:model_version,
                dams:name,
                dams:ownership_inheritance_rule,
                dams:owning_unit_ref,
                dams:selections,
                dams:specification_version,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description """Явное соответствие между элементами. Discriminate via mapping_type: realizes (solution→enterprise conceptual), entity_physical (PhysicalObject↔LogicalEntity), field_mapping/mapsTo (physical↔logical), aligns_with (enterprise↔external term). Not used for SpecImpl implements/conforms_to.
""" ;
            dams:name "Mapping" ;
            linkml:class_uri "https://data.moex.com/dams/Mapping"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/Mapping"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasProvenance ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:approval_status,
                dams:approved_at,
                dams:approved_by_ref,
                dams:confidence,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:evidence_refs,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:mapping_cardinality,
                dams:mapping_type,
                dams:name,
                dams:source_artifact_ref,
                dams:source_refs,
                dams:tags,
                dams:target_refs,
                dams:title,
                dams:transformation_expression,
                dams:transformation_ref,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/governance/v0.1"^^xsd:anyURI ;
            dams:description """Mixin привязки управляемых политик к элементу модели. policy_refs участвует в containment cascade (ADR-023): отсутствие ключа — наследование; присутствующий список (в т.ч. пустой) — полная замена.
""" ;
            dams:name "HasPolicyBindings" ;
            linkml:class_uri "https://data.moex.com/dams/HasPolicyBindings"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/HasPolicyBindings"^^xsd:anyURI ;
            linkml:mixin true ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:policy_refs ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "Локальная ссылочная проекция записи внешней мастер-системы; не является мастер-копией справочника." ;
            dams:name "RegistryEntry" ;
            linkml:abstract true ;
            linkml:class_uri "https://data.moex.com/dams/RegistryEntry"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/RegistryEntry"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/contract-binding/v0.1"^^xsd:anyURI ;
            dams:description "Выбранный атрибут и соответствующее физическое поле payload, таблицы или сообщения." ;
            dams:name "SelectedAttribute" ;
            linkml:class_uri "https://data.moex.com/dams/SelectedAttribute"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/SelectedAttribute"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:logical_attribute_ref,
                dams:name,
                dams:physical_field_refs,
                dams:tags,
                dams:title,
                dams:transformation_mapping_ref,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/requirements/v0.1"^^xsd:anyURI ;
            dams:description "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
            dams:name "RequirementCatalog" ;
            linkml:class_uri "https://data.moex.com/dams/RequirementCatalog"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/RequirementCatalog"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:catalog_id,
                dams:name,
                dams:requirements ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/contract-binding/v0.1"^^xsd:anyURI ;
            dams:description "Выбранная для интеграции логическая сущность." ;
            dams:name "SelectedEntity" ;
            linkml:class_uri "https://data.moex.com/dams/SelectedEntity"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/SelectedEntity"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
