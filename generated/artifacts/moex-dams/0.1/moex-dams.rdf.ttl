            dams:name "CompatibilityModeEnum" ;
            linkml:definition_uri "https://data.moex.com/dams/CompatibilityModeEnum"^^xsd:anyURI ;
            linkml:permissible_values dams:backward,
                dams:forward,
                dams:full,
                dams:none ],
