        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/governance/v0.1"^^xsd:anyURI ;
            dams:description """Mixin эталонного определения (ADR-025). Слот description остаётся skos:definition (own text). Отсутствие description при наличии definition_source_ref означает наследование; заданный description — own (опционально adapted from source). scoped_definitions — контекстные определения (v1: уровень ITSystem), не заменяющие эталон вне scope.
""" ;
            dams:name "HasDefinition" ;
