            dams:description """Kind of Mapping assertion. realizes = solution element → enterprise conceptual; field_mapping = mapsTo (physical ↔ logical); aligns_with = enterprise conceptual ↔ external term. Do not use Mapping for SpecImpl implements (that is conforms_to / publication implements).
""" ;
            dams:name "MappingTypeEnum" ;
            linkml:definition_uri "https://data.moex.com/dams/MappingTypeEnum"^^xsd:anyURI ;
            linkml:permissible_values dams:aggregation,
                dams:aligns_with,
                dams:derivation,
                dams:field_mapping,
                dams:implementation,
                dams:realizes,
                dams:semantic_equivalence,
                dams:specialization,
                dams:transformation ],
