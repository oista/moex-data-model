            dams:name "MappingCardinalityEnum" ;
            linkml:definition_uri "https://data.moex.com/dams/MappingCardinalityEnum"^^xsd:anyURI ;
            linkml:permissible_values dams:many_to_many,
                dams:many_to_one,
                dams:one_to_many,
