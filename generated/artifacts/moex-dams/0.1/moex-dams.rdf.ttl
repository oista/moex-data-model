@prefix dams: <https://data.moex.com/dams/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dams:ATR dams:description "Атрибуты" .

dams:CLS dams:description "Классификация данных" .

dams:FLW dams:description "Потоки данных" .

dams:GEN dams:description "Общие требования" .

dams:LDM dams:description "Логическая модель" .

dams:PDM dams:description "Физическая модель" .

dams:REF dams:description "Связи сущностей" .

dams:aligns_with dams:description "Enterprise conceptual aligns with an external reference term." .

dams:analytical_data dams:description "Аналитические или производные наборы данных." .

dams:conceptual_model dams:description "Концептуальная модель" .

dams:core dams:description "Базовая сущность, создаваемая и управляемая решением." .

dams:dams-data-model dams:description "MOEX DAMS corporate data-model implementation." .

dams:derived dams:description "Производная сущность, вычисляемая или агрегируемая из других данных." .

dams:enterprise dams:description "Enterprise-wide scope (no solution_ref)." .

dams:enterprise-conceptual dams:description "Enterprise corporate conceptual model (solution-independent)." .

dams:field_mapping dams:description "Technical/structural mapsTo between physical and logical." .

dams:it_solution dams:description "ИТ-решение" .

dams:it_system dams:description "ИТ-система" .

dams:master_data dams:description "Мастер-данные." .

dams:metadata dams:description "Метаданные." .

dams:ontology-application dams:description "Not a DAMS model Impl — ontology application profile." .

dams:realizes dams:description "Solution logical/concept realizes an enterprise conceptual entity." .

dams:reference dams:description "Справочная сущность или представление управляемого справочника." .

dams:reference_data dams:description "Нормативно-справочная информация (НСИ)." .

dams:transactional_data dams:description "Транзакционные данные." .

dams:solution dams:description "IT-solution model with local logical/physical facets.",
        "Scoped to a specific IT solution." .

[] a linkml:SchemaDefinition ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0" ;
    pav:version "0.1.0" ;
    sh:declare [ sh:namespace "https://data.moex.com/dams/"^^xsd:anyURI ;
            sh:prefix "dams" ],
        [ sh:namespace "https://w3id.org/linkml/"^^xsd:anyURI ;
            sh:prefix "linkml" ],
        [ sh:namespace "https://data.moex.com/"^^xsd:anyURI ;
            sh:prefix "moex" ] ;
    dams:name "moex_dams" ;
    linkml:classes [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/contract-binding/v0.1"^^xsd:anyURI ;
            dams:description "Дочерняя модельная спецификация дата-контракта, фиксирующая неизменяемую ревизию модели и передаваемый срез." ;
            dams:name "DataModelBinding" ;
            linkml:class_uri "https://data.moex.com/dams/DataModelBinding"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/DataModelBinding"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasLifecycle,
                dams:HasOwnership ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:compatibility_baseline_ref,
                dams:compatibility_mode,
                dams:contract_ref,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:generated_at,
                dams:glossary_term_refs,
                dams:implementation_version,
                dams:integration_ref,
                dams:integrity_digest,
                dams:lifecycle_status,
                dams:model_package_ref,
                dams:model_revision,
                dams:model_version,
                dams:name,
                dams:owning_unit_ref,
                dams:selections,
                dams:specification_version,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "Бизнес-домен или предметная область; мастер определяется архитектурным governance." ;
            dams:name "BusinessDomain" ;
            linkml:class_uri "https://data.moex.com/dams/BusinessDomain"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/BusinessDomain"^^xsd:anyURI ;
            linkml:is_a dams:RegistryEntry ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:parent_domain_ref,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Абстрактный корень иерархии элементов модели: общая идентичность (element_id), имя, описание и жизненный цикл." ;
            dams:name "ModelElement" ;
            linkml:abstract true ;
            linkml:class_uri "https://data.moex.com/dams/ModelElement"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ModelElement"^^xsd:anyURI ;
            linkml:mixins dams:HasLifecycle ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:name,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Именованная связь между логическими или концептуальными сущностями." ;
            dams:name "Relationship" ;
            linkml:class_uri "https://data.moex.com/dams/Relationship"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/Relationship"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:associative,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:glossary_term_refs,
                dams:identifying,
                dams:lifecycle_status,
                dams:name,
                dams:source_entity_ref,
                dams:source_max_cardinality,
                dams:source_min_cardinality,
                dams:source_role,
                dams:tags,
                dams:target_entity_ref,
                dams:target_max_cardinality,
                dams:target_min_cardinality,
                dams:target_role,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/requirements/v0.1"^^xsd:anyURI ;
            dams:description "Нормативное требование к модели, соответствующей reference specification (каталог для уровня ИТ-решения и др.)." ;
            dams:name "SpecificationRequirement" ;
            linkml:class_uri "https://data.moex.com/dams/SpecificationRequirement"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/SpecificationRequirement"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:code,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:formal_checks,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:name,
                dams:requirement_level,
                dams:requirement_section,
                dams:statement,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "ИТ-система; мастер данных — EAM." ;
            dams:name "ITSystem" ;
            linkml:class_uri "https://data.moex.com/dams/ITSystem"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ITSystem"^^xsd:anyURI ;
            linkml:is_a dams:RegistryEntry ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/requirements/v0.1"^^xsd:anyURI ;
            dams:description "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
            dams:name "RequirementCatalog" ;
            linkml:class_uri "https://data.moex.com/dams/RequirementCatalog"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/RequirementCatalog"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:catalog_id,
                dams:name,
                dams:requirements ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/analytics/v0.1"^^xsd:anyURI ;
            dams:description "Управляемое определение бизнес- или технической метрики; является опциональным аналитическим профилем." ;
            dams:name "Metric" ;
            linkml:class_uri "https://data.moex.com/dams/Metric"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/Metric"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasOwnership,
                dams:HasPolicyBindings ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aggregation_function,
                dams:aliases,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:dimension_attribute_refs,
                dams:element_id,
                dams:filter_expression,
                dams:glossary_term_refs,
                dams:grain_entity_refs,
                dams:lifecycle_status,
                dams:measure_attribute_refs,
                dams:metric_expression,
                dams:name,
                dams:owning_unit_ref,
                dams:policy_refs,
                dams:tags,
                dams:title,
                dams:unit,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/governance/v0.1"^^xsd:anyURI ;
            dams:description "Версионируемое назначение категории классификации элементу модели с основанием и периодом действия." ;
            dams:name "ClassificationAssignment" ;
            linkml:class_uri "https://data.moex.com/dams/ClassificationAssignment"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ClassificationAssignment"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:approval_status,
                dams:assignment_id,
                dams:classification_rationale,
                dams:classification_source,
                dams:classification_term_ref,
                dams:classified_element_ref,
                dams:governance_classification,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/requirements/v0.1"^^xsd:anyURI ;
            dams:description "Одна машиночитаемая проверка требования. Kind выровнен с LinkML constraints и DAMS reference/structural diagnostics; assess wiring может появиться позже." ;
            dams:name "FormalCheck" ;
            linkml:class_uri "https://data.moex.com/dams/FormalCheck"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/FormalCheck"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:check_id,
                dams:diagnostic_code,
                dams:expression,
                dams:kind,
                dams:severity,
                dams:target_class,
                dams:target_path,
                dams:target_slot ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/integration/v0.1"^^xsd:anyURI ;
            dams:description "Ссылочная проекция зарегистрированной интеграции; топология и канал являются данными Clinkr, а семантика — модели данных." ;
            dams:name "DataFlow" ;
            linkml:class_uri "https://data.moex.com/dams/DataFlow"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/DataFlow"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasLifecycle,
                dams:HasOwnership ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:contract_ref,
                dams:data_owner_ref,
                dams:data_steward_ref,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:entity_bindings,
                dams:glossary_term_refs,
                dams:integration_channel,
                dams:integration_class,
                dams:integration_level,
                dams:integration_ref,
                dams:integration_spec_ref,
                dams:lifecycle_status,
                dams:name,
                dams:owning_unit_ref,
                dams:source_platform_ref,
                dams:source_solution_ref,
                dams:source_system_ref,
                dams:tags,
                dams:target_platform_ref,
                dams:target_solution_ref,
                dams:target_system_ref,
                dams:title,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description "Логический атрибут сущности с бизнес-смыслом, типом, обязательностью и классификацией." ;
            dams:name "LogicalAttribute" ;
            linkml:class_uri "https://data.moex.com/dams/LogicalAttribute"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/LogicalAttribute"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasGovernanceClassification,
                dams:HasPolicyBindings ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:classification_rationale,
                dams:classification_source,
                dams:default_value,
                dams:deprecated_by_ref,
                dams:derived_expression,
                dams:description,
                dams:element_id,
                dams:format_pattern,
                dams:glossary_term_refs,
                dams:governance_classification,
                dams:lifecycle_status,
                dams:logical_type,
                dams:maximum_cardinality,
                dams:minimum_cardinality,
                dams:multivalued,
                dams:name,
                dams:owner_entity_ref,
                dams:policy_refs,
                dams:required,
                dams:sensitivity_term_refs,
                dams:tags,
                dams:title,
                dams:valid_from,
                dams:valid_to,
                dams:value_set_ref ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "Специальная категория чувствительности или регулирования, например ПДн или инсайдерская информация." ;
            dams:name "DataClassificationTerm" ;
            linkml:class_uri "https://data.moex.com/dams/DataClassificationTerm"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/DataClassificationTerm"^^xsd:anyURI ;
            linkml:is_a dams:RegistryEntry ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/core/v0.1"^^xsd:anyURI ;
            dams:description """Явное соответствие между элементами. Discriminate via mapping_type: realizes (solution→enterprise conceptual), field_mapping/mapsTo (physical↔logical), aligns_with (enterprise↔external term). Not used for SpecImpl implements/conforms_to.
""" ;
            dams:name "Mapping" ;
            linkml:class_uri "https://data.moex.com/dams/Mapping"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/Mapping"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:mixins dams:HasProvenance ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:approval_status,
                dams:approved_at,
                dams:approved_by_ref,
                dams:confidence,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:evidence_refs,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:mapping_cardinality,
                dams:mapping_type,
                dams:name,
                dams:source_artifact_ref,
                dams:source_refs,
                dams:tags,
                dams:target_refs,
                dams:title,
                dams:transformation_expression,
                dams:transformation_ref,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "Организационное подразделение." ;
            dams:name "OrganizationUnit" ;
            linkml:class_uri "https://data.moex.com/dams/OrganizationUnit"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/OrganizationUnit"^^xsd:anyURI ;
            linkml:is_a dams:RegistryEntry ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/governance/v0.1"^^xsd:anyURI ;
            dams:description "Mixin жизненного цикла: статус, период действия и ссылка на заменяющий элемент." ;
            dams:name "HasLifecycle" ;
            linkml:class_uri "https://data.moex.com/dams/HasLifecycle"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/HasLifecycle"^^xsd:anyURI ;
            linkml:mixin true ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:deprecated_by_ref,
                dams:lifecycle_status,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/governance/v0.1"^^xsd:anyURI ;
            dams:description "Mixin владения: data owner, data steward и организационное подразделение." ;
            dams:name "HasOwnership" ;
            linkml:class_uri "https://data.moex.com/dams/HasOwnership"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/HasOwnership"^^xsd:anyURI ;
            linkml:mixin true ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:data_owner_ref,
                dams:data_steward_ref,
                dams:owning_unit_ref ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "Локальная ссылочная проекция записи внешней мастер-системы; не является мастер-копией справочника." ;
            dams:name "RegistryEntry" ;
            linkml:abstract true ;
            linkml:class_uri "https://data.moex.com/dams/RegistryEntry"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/RegistryEntry"^^xsd:anyURI ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "Термин корпоративного бизнес-глоссария." ;
            dams:name "GlossaryTerm" ;
            linkml:class_uri "https://data.moex.com/dams/GlossaryTerm"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/GlossaryTerm"^^xsd:anyURI ;
            linkml:is_a dams:RegistryEntry ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/registries/v0.1"^^xsd:anyURI ;
            dams:description "ИТ-платформа; мастер данных — EAM." ;
            dams:name "ITPlatform" ;
            linkml:class_uri "https://data.moex.com/dams/ITPlatform"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/ITPlatform"^^xsd:anyURI ;
            linkml:is_a dams:RegistryEntry ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:master_system,
                dams:registry_description,
                dams:registry_id,
                dams:registry_name,
                dams:registry_status,
                dams:source_uri ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/contract-binding/v0.1"^^xsd:anyURI ;
            dams:description "Выбранный атрибут и соответствующее физическое поле payload, таблицы или сообщения." ;
            dams:name "SelectedAttribute" ;
            linkml:class_uri "https://data.moex.com/dams/SelectedAttribute"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/SelectedAttribute"^^xsd:anyURI ;
            linkml:is_a dams:ModelElement ;
            linkml:slot_usage [ ] ;
            linkml:slots dams:aliases,
                dams:deprecated_by_ref,
                dams:description,
                dams:element_id,
                dams:glossary_term_refs,
                dams:lifecycle_status,
                dams:logical_attribute_ref,
                dams:name,
                dams:physical_field_refs,
                dams:tags,
                dams:title,
                dams:transformation_mapping_ref,
                dams:valid_from,
                dams:valid_to ],
        [ a linkml:ClassDefinition ;
            skos:inScheme "https://data.moex.com/dams/analytics/v0.1"^^xsd:anyURI ;
            dams:description "Переиспользуемое аналитическое измерение, связанное с логическими атрибутами." ;
            dams:name "Dimension" ;
            linkml:class_uri "https://data.moex.com/dams/Dimension"^^xsd:anyURI ;
            linkml:definition_uri "https://data.moex.com/dams/Dimension"^^xsd:anyURI ;
