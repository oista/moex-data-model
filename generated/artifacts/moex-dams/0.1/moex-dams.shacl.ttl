        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:solution_ref ] ;
