dams:ConceptualEntity a sh:NodeShape ;
    rdfs:comment "Корпоративное бизнес-понятие верхнего уровня, независимое от конкретной реализации." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dams:valid_from ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:tags ],
        [ sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:key_attribute_refs ],
        [ sh:in ( "core" "derived" "reference" "projection" "technical" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path dams:entity_type ],
        [ sh:description """Required when entity_tier=dependent. characteristic = part/detail of an owner; associative = M:N resolver between owners (ADR-026).
""" ;
            sh:in ( "characteristic" "associative" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path dams:dependency_kind ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:valid_to ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:ConceptualEntity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:parent_concept_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:data_steward_ref ],
        [ sh:description """Structural independence of the conceptual entity (ADR-026). primary = independent existence; dependent = requires depends_on_refs.
""" ;
            sh:in ( "primary" "dependent" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:entity_tier ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:definition_rationale ],
        [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dams:scoped_definitions ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:owning_unit_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:name ],
        [ sh:datatype xsd:string ;
            sh:description """Reference definition (skos:definition). Absent means inherit via definition_source_ref (ontology class or GlossaryTerm) per ADR-025.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:aliases ],
        [ sh:in ( "critical" "high" "medium" "low" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path dams:business_importance ],
        [ sh:class dams:ExternalClassRef ;
            sh:description """Canonical ConceptualEntity → external class/term alignments with match_kind (ADR-026). Non-empty iff genesis_kind=external.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:external_class_refs ],
        [ sh:in ( "reference_data" "master_data" "transactional_data" "analytical_data" "metadata" "operational_data" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path dams:data_class ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:title ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:definition_source_ref ],
        [ sh:class dams:ConceptualEntity ;
            sh:description """Owner conceptual entities this dependent entity requires. Empty for primary; at least one for dependent (ADR-026).
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:depends_on_refs ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 24 ;
            sh:path dams:lifecycle_status ],
        [ sh:description """external = aligns to ontology/external class(es); native = modelled without external parents (ADR-026).
""" ;
            sh:in ( "external" "native" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path dams:genesis_kind ] ;
    sh:targetClass dams:ConceptualEntity .

dams:DataCarrier a sh:NodeShape ;
    rdfs:comment """Носитель данных: хранит или передаёт данные (таблица, файл, топик, сообщение и т.п.).
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:classification_source ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:qualified_name ],
        [ sh:description """Направление относительно решения. Запрещён для DataContainer и ExecutionAsset правилом DAMS-валидатора и LinkML rules.
""" ;
            sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path dams:direction ],
        [ sh:class dams:PhysicalField ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:physical_fields ],
        [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:asset_namespace ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:native_name ],
        [ sh:class dams:ITSystem ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:system_ref ],
        [ sh:description "Роль актива в lineage (source, sink, intermediate, none)." ;
            sh:in ( "source" "sink" "intermediate" "none" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path dams:lineage_role ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:solution_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:location_uri ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path dams:element_id ],
        [ sh:in ( "composite" "partitioned" "hierarchical" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:containment_kind ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:data_steward_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование для planned / technical-only / not-applicable / inherited." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:mapping_rationale ],
        [ sh:description """Ссылка на структуру данных (пока uriorcurie; в будущем DataStructure).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:structure_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path dams:valid_from ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:owning_unit_ref ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:title ],
        [ sh:class dams:TechnicalAsset ;
            sh:description "Родитель в контейнерной иерархии (без циклов)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:parent_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 39 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:technology ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 36 ;
            sh:path dams:lifecycle_status ],
        [ sh:description """Статус покрытия элемента mapping’ом на соседнем уровне модели (logical ↔ physical).
""" ;
            sh:in ( "mapped" "derived" "planned" "inherited" "technical-only" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:mapping_coverage_status ],
        [ sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:in ( "relational_table" "relational_view" "file" "dataset" "stream_topic" "stream_queue" "message_type" "in_memory" "api_resource" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path dams:asset_kind ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:data_owner_ref ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 23 ;
            sh:path dams:governance_classification ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:description "Диалект схемы (например avro, json-schema, sql-ddl)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:schema_dialect ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:region ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:description "Формат данных (например parquet, csv, json)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:data_format ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:classification_rationale ] ;
    sh:targetClass dams:DataCarrier .

dams:DataType a sh:NodeShape ;
    rdfs:comment """Корпоративный тип данных: семейство, параметры представления и соответствие XSD/LinkML. Допустим только в корпоративном реестре типов.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Политика часового пояса для date/time/datetime типов." ;
            sh:in ( "none" "utc" "with_offset" "local" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path dams:datatype_timezone_policy ],
        [ sh:datatype xsd:integer ;
            sh:description "Минимальная длина для string/binary." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:min_length ],
        [ sh:datatype xsd:string ;
            sh:description "Имя типа LinkML (string, integer, …)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:linkml_type ],
        [ sh:datatype xsd:integer ;
            sh:description "Точность для decimal (общее число цифр)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:precision ],
        [ sh:description "Соответствующий XSD datatype (например xsd:string)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:xsd_datatype ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:aliases ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:integer ;
            sh:description "Максимальная длина для string/binary." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:max_length ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 18 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:name ],
        [ sh:class dams:DataType ;
            sh:description "Базовый тип, от которого наследуются параметры." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:base_type_ref ],
        [ sh:description "Семейство типа (boolean, integer, decimal, …)." ;
            sh:in ( "boolean" "integer" "decimal" "float" "string" "binary" "date" "time" "datetime" "duration" "identifier" "uri" "object" "array" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:type_family ],
        [ sh:datatype xsd:string ;
            sh:description "Каноническое имя типа в корпоративном реестре." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:type_name ],
        [ sh:datatype xsd:string ;
            sh:description "Кодировка для string/binary." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:charset ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:description ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:integer ;
            sh:description "Масштаб для decimal (число цифр после запятой); scale ≤ precision." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:scale ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:title ] ;
    sh:targetClass dams:DataType .

dams:LogicalAttribute a sh:NodeShape ;
    rdfs:comment """Логический атрибут сущности: идентификация, обязательность, кардинальность и ссылки на представление (DataType/ValueDomain) и опционально на ConceptualProperty (вариант B, ADR-034).
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:classification_source ],
        [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path dams:scoped_definitions ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:required ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:description "Ссылка на атрибут валюты для денежной величины (Wave 2 soft)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:currency_attribute_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path dams:title ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path dams:governance_classification ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:value_set_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:derived_expression ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 40 ;
            sh:path dams:lifecycle_status ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path dams:definition_source_ref ],
        [ sh:class dams:LogicalEntity ;
            sh:description """Structural parent LogicalEntity of this attribute (containment), not the data owner role. Data ownership uses data_owner_ref via HasOwnership / ADR-023 cascade.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:owner_entity_ref ],
        [ sh:datatype xsd:boolean ;
            sh:description """Признак критичного элемента данных (CDE). Единственный источник правды для critical_data; термин CDE в ClassificationAssignment не вводится (ADR-034).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:critical_data_element ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path dams:element_id ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:data_steward_ref ],
        [ sh:in ( "string" "integer" "decimal" "boolean" "date" "datetime" "time" "binary" "identifier" "uri" "object" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path dams:logical_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:default_value ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 38 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 41 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование для planned / technical-only / not-applicable / inherited." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:mapping_rationale ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path dams:classification_rationale ],
        [ sh:datatype xsd:string ;
            sh:description """Reference definition (skos:definition). Prefer ADR-025 (definition_source_ref / scoped_definitions); do not copy from ConceptualProperty.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path dams:description ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:multivalued ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Код единицы измерения (UCUM / корпоративный код)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:unit_code ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 39 ;
            sh:path dams:tags ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 43 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:ValueDomain ;
            sh:description "Ссылка на домен представления значений." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:value_domain_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:description "Семантика даты/времени (Wave 2 soft)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:temporal_semantics ],
        [ sh:class dams:DataType ;
            sh:description """Ссылка на корпоративный DataType. На переходе достаточно одного из value_domain_ref, data_type_ref или logical_type.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:data_type_ref ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path dams:name ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:minimum_cardinality ],
        [ sh:datatype xsd:string ;
            sh:description "Политика часового пояса для timestamp (Wave 2 soft)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:timezone_policy ],
        [ sh:class dams:ConceptualProperty ;
            sh:description """Опциональная ссылка на ConceptualProperty. Отсутствие не является ошибкой и не порождает предупреждение (вариант B).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:concept_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:format_pattern ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 25 ;
            sh:path dams:security_classification ],
        [ sh:description """Статус покрытия элемента mapping’ом на соседнем уровне модели (logical ↔ physical).
""" ;
            sh:in ( "mapped" "derived" "planned" "inherited" "technical-only" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path dams:mapping_coverage_status ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:maximum_cardinality ],
        [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:definition_rationale ] ;
    sh:targetClass dams:LogicalAttribute .

dams:LogicalEntity a sh:NodeShape ;
    rdfs:comment "Представление бизнес-сущности в доменном контексте и модели конкретного решения." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path dams:element_id ],
        [ sh:in ( "natural" "composite" "external" "local" "surrogate" "derived" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:business_key_kind ],
        [ sh:datatype xsd:string ;
            sh:description """Reference definition (skos:definition). Absent means inherit from conceptual_entity_refs or definition_source_ref per ADR-025.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:description ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 20 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование семантической изоляции сущности (LDM-007)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:isolation_rationale ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path dams:tags ],
        [ sh:in ( "critical" "high" "medium" "low" ) ;
            sh:maxCount 1 ;
            sh:order 18 ;
            sh:path dams:business_importance ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:data_owner_ref ],
        [ sh:in ( "aligned" "pending" "local-only" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path dams:conceptual_alignment_status ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:solution_ref ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:description """Деловое правило идентичности экземпляров сущности в контексте ИТ-решения.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:identity_rule ],
        [ sh:class dams:DomainContext ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:context_ref ],
        [ sh:class dams:ConceptualEntity ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:conceptual_entity_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 38 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:owning_unit_ref ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 35 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование статуса выравнивания с концептуальным уровнем." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:alignment_rationale ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:title ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path dams:definition_source_ref ],
        [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:definition_rationale ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dams:name ],
        [ sh:in ( "producer" "consumer" "intermediary" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path dams:solution_data_role ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path dams:governance_classification ],
        [ sh:in ( "reference_data" "master_data" "transactional_data" "analytical_data" "metadata" "operational_data" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path dams:data_class ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:classification_source ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path dams:glossary_term_refs ],
        [ sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:key_attribute_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:classification_rationale ],
        [ sh:in ( "core" "derived" "reference" "projection" "technical" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path dams:entity_type ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:invariant_refs ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dams:scoped_definitions ],
        [ sh:class dams:LogicalAttribute ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:attributes ] ;
    sh:targetClass dams:LogicalEntity .

dams:ScopedDefinition a sh:NodeShape ;
    rdfs:comment """Контекстное определение элемента модели (ADR-025 / ISO 11179 Context). Не является отдельным термином глоссария и не заменяет эталонное определение вне указанного scope.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:evidence_refs ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:approval_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:source_artifact_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Why this scoped wording differs from the reference definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:rationale ],
        [ sh:datatype xsd:string ;
            sh:description "Scoped definition text (skos:definition in this context)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:text ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:approved_at ],
        [ sh:description """Target of the scope (e.g. ITSystem registry id). For scope_kind=system must be a member of the solution's ITSolution.member_system_refs.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:scope_ref ],
        [ sh:in ( "system" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:scope_kind ],
        [ sh:in ( "refines" "narrows" "alternative" "replaces" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path dams:relation_to_reference ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:scoped_definition_id ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:approved_by_ref ] ;
    sh:targetClass dams:ScopedDefinition .

dams:TechnicalAsset a sh:NodeShape ;
    rdfs:comment """Квант данных: адресуемый технический объект управления. Имеет собственный идентификатор, систему-владельца, расположение или способ доступа, жизненный цикл, владельца, классификацию и роль в lineage. Поля, колонки и узлы схем квантами НЕ являются (ADR-C).
""" ;
    sh:closed false ;
    sh:ignoredProperties ( dams:produces_refs dams:protocol_version dams:http_method dams:protocol rdf:type dams:operation_name dams:physical_fields dams:schema_dialect dams:consumes_refs dams:containment_kind dams:mapping_rationale dams:structure_ref dams:path_template dams:data_format dams:binding_ref dams:region dams:interface_ref dams:mapping_coverage_status dams:serves_refs dams:location_uri ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:name ],
        [ sh:datatype xsd:string ;
            sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:asset_kind ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 27 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:asset_namespace ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path dams:security_classification ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:element_id ],
        [ sh:class dams:ITSystem ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:system_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path dams:valid_from ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 14 ;
            sh:path dams:governance_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:classification_source ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:technology ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:classification_rationale ],
        [ sh:class dams:TechnicalAsset ;
            sh:description "Родитель в контейнерной иерархии (без циклов)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:parent_ref ],
        [ sh:description """Направление относительно решения. Запрещён для DataContainer и ExecutionAsset правилом DAMS-валидатора и LinkML rules.
""" ;
            sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:direction ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:solution_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:native_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:title ],
        [ sh:description "Роль актива в lineage (source, sink, intermediate, none)." ;
            sh:in ( "source" "sink" "intermediate" "none" ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path dams:lineage_role ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:qualified_name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:data_owner_ref ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:owning_unit_ref ] ;
    sh:targetClass dams:TechnicalAsset .

dams:ITSystem a sh:NodeShape ;
    rdfs:comment "ИТ-система; мастер данных — EAM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:registry_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:master_system ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
