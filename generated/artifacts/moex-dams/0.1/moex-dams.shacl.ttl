dams:RelationTerm a sh:NodeShape ;
    rdfs:comment """Governed dictionary term for a conceptual/logical relationship (ADR-026). Provides forward and inverse natural-language labels so a single Relationship assertion can be read from either side.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:definition_rationale ],
        [ sh:datatype xsd:string ;
            sh:description "Natural-language label source → target (ADR-026)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:forward_label ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:name ],
        [ sh:description """Optional owl:ObjectProperty IRI. Reserve for future property import; not required in v1 (ADR-026 / ADR-024 §7).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:ontology_property_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:description """Natural-language label target → source. Required unless symmetric (ADR-026).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:inverse_label ],
        [ sh:datatype xsd:string ;
            sh:description "English inverse label (ADR-026)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:inverse_label_en ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:boolean ;
            sh:description """When true, forward and inverse labels are the same; inverse_label may be omitted (ADR-026).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:symmetric ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:definition_source_ref ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:scoped_definitions ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:element_id ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 17 ;
            sh:path dams:lifecycle_status ],
        [ sh:description "Optional default relationship_kind when this term is used." ;
            sh:in ( "association" "composition" "aggregation" "specialization" "reference" "derivation" "realization" "lineage" "event_participation" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path dams:default_relationship_kind ],
        [ sh:datatype xsd:string ;
            sh:description "English forward label (ADR-026)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:forward_label_en ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:description """Reference definition of the relation term (skos:definition). Absent means inherit via definition_source_ref per ADR-025.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:description ] ;
    sh:targetClass dams:RelationTerm .

dams:SpecificationRequirement a sh:NodeShape ;
    rdfs:comment "Нормативное требование к модели, соответствующей reference specification (каталог для уровня ИТ-решения и др.)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:code ;
            sh:pattern "^(LDM|PDM|REF|ATR|FLW|CLS|GEN)-[0-9]{3}$" ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:description """Полная нормативная формулировка на русском для человека: без имён LinkML-классов, слотов, kinds проверок и сленга метамодели.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:statement ],
        [ sh:defaultValue "draft" ;
            sh:in ( "draft" "proposed" "approved" "rejected" "deprecated" "superseded" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path dams:lifecycle_status ],
        [ sh:description """Статус реализации требования. Осмысленно при lifecycle_status=approved; обязательность при approved не проверяется в этой версии схемы.
""" ;
            sh:in ( "not_started" "in_progress" "implemented" "verified" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path dams:implementation_status ],
        [ sh:class dams:RequirementApplicability ;
            sh:description "Область применимости требования для formal_checks runner." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:applies_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:title ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:element_id ],
        [ sh:class dams:FormalCheck ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:formal_checks ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:tags ],
        [ sh:in ( "conceptual_model" "it_solution" "it_system" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:requirement_level ],
        [ sh:in ( "LDM" "PDM" "REF" "ATR" "FLW" "CLS" "GEN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dams:requirement_section ],
        [ sh:class dams:SpecificationRequirement ;
            sh:description """Ссылка на требование, которым данное заменено (при lifecycle_status=superseded). Отличается от deprecated_by_ref (HasLifecycle): deprecated_by_ref означает «устарело из-за …» без обязательной замены нормой; superseded_by — «заменено указанным требованием». Обязательность при superseded не проверяется здесь.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:superseded_by ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:aliases ] ;
    sh:targetClass dams:SpecificationRequirement .

dams:BusinessDomain a sh:NodeShape ;
    rdfs:comment "Бизнес-домен или предметная область; мастер определяется архитектурным governance" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:master_system ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:registry_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:registry_description ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:source_uri ],
        [ sh:class dams:BusinessDomain ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:parent_domain_ref ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path dams:registry_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:registry_id ] ;
    sh:targetClass dams:BusinessDomain .

dams:ITPlatform a sh:NodeShape ;
    rdfs:comment "ИТ-платформа; мастер данных — EAM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:registry_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:master_system ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dams:registry_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:source_uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:registry_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:registry_description ] ;
    sh:targetClass dams:ITPlatform .

dams:Mapping a sh:NodeShape ;
    rdfs:comment """Явное соответствие между элементами. Discriminate via mapping_type: realizes (solution→enterprise conceptual), entity_physical (DataCarrier↔LogicalEntity), field_mapping/mapsTo (PhysicalField↔LogicalAttribute), aligns_with (enterprise↔external term). Not used for SpecImpl implements/conforms_to.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:approved_at ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:transformation_expression ],
        [ sh:in ( "semantic_equivalence" "specialization" "implementation" "entity_physical" "field_mapping" "transformation" "aggregation" "derivation" "realizes" "aligns_with" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dams:mapping_type ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:aliases ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:target_refs ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 21 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:valid_to ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:approved_by_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:tags ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path dams:approval_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:description ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:element_id ],
        [ sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:source_refs ],
        [ sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:evidence_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:transformation_ref ],
        [ sh:in ( "one_to_one" "one_to_many" "many_to_one" "many_to_many" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path dams:mapping_cardinality ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:source_artifact_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:title ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:confidence ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:valid_from ] ;
    sh:targetClass dams:Mapping .

dams:PhysicalField a sh:NodeShape ;
    rdfs:comment """Поле носителя данных (DataCarrier); семантика задаётся Mapping к LogicalAttribute.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:required ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:schema_path ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dams:tags ],
        [ sh:description """Статус покрытия элемента mapping’ом на соседнем уровне модели (logical ↔ physical).
""" ;
            sh:in ( "mapped" "derived" "planned" "inherited" "technical-only" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path dams:mapping_coverage_status ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование для planned / technical-only / not-applicable / inherited." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:mapping_rationale ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:aliases ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:title ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:native_name ],
        [ sh:class dams:DataCarrier ;
            sh:description "Носитель данных, которому принадлежит поле." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:carrier_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:classification_source ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path dams:governance_classification ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:ordinal_position ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:native_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:classification_rationale ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:element_id ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 25 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:data_steward_ref ] ;
    sh:targetClass dams:PhysicalField .

dams:ConceptualEntity a sh:NodeShape ;
    rdfs:comment "Корпоративное бизнес-понятие верхнего уровня, независимое от конкретной реализации." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "reference_data" "master_data" "transactional_data" "analytical_data" "metadata" "operational_data" ) ;
            sh:maxCount 1 ;
            sh:order 12 ;
            sh:path dams:data_class ],
        [ sh:in ( "critical" "high" "medium" "low" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path dams:business_importance ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:in ( "core" "derived" "reference" "projection" "technical" ) ;
            sh:maxCount 1 ;
            sh:order 11 ;
            sh:path dams:entity_type ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:ExternalClassRef ;
            sh:description """Canonical ConceptualEntity → external class/term alignments with match_kind (ADR-026). Non-empty iff genesis_kind=external.
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:external_class_refs ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 24 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:description """Reference definition (skos:definition). Absent means inherit via definition_source_ref (ontology class or GlossaryTerm) per ADR-025.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:description ],
        [ sh:class dams:ConceptualEntity ;
            sh:description """Owner conceptual entities this dependent entity requires. Empty for primary; at least one for dependent (ADR-026).
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:depends_on_refs ],
        [ sh:class dams:ConceptualEntity ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:parent_concept_ref ],
        [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dams:scoped_definitions ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:data_owner_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:name ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:definition_source_ref ],
        [ sh:description """Required when entity_tier=dependent. characteristic = part/detail of an owner; associative = M:N resolver between owners (ADR-026).
""" ;
            sh:in ( "characteristic" "associative" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path dams:dependency_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:title ],
        [ sh:description """Structural independence of the conceptual entity (ADR-026). primary = independent existence; dependent = requires depends_on_refs.
""" ;
            sh:in ( "primary" "dependent" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:entity_tier ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:definition_rationale ],
        [ sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:key_attribute_refs ],
        [ sh:description """external = aligns to ontology/external class(es); native = modelled without external parents (ADR-026).
""" ;
            sh:in ( "external" "native" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path dams:genesis_kind ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:glossary_term_refs ] ;
    sh:targetClass dams:ConceptualEntity .

dams:DataCarrier a sh:NodeShape ;
    rdfs:comment """Носитель данных: хранит или передаёт данные (таблица, файл, топик, сообщение и т.п.).
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:title ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:location_uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:classification_rationale ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path dams:valid_from ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 24 ;
            sh:path dams:security_classification ],
        [ sh:in ( "composite" "partitioned" "hierarchical" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:containment_kind ],
        [ sh:description """Ссылка на структуру данных (пока uriorcurie; в будущем DataStructure).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:structure_ref ],
        [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:asset_namespace ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:native_name ],
        [ sh:datatype xsd:string ;
            sh:description "Диалект схемы (например avro, json-schema, sql-ddl)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:schema_dialect ],
        [ sh:description "Роль актива в lineage (source, sink, intermediate, none)." ;
            sh:in ( "source" "sink" "intermediate" "none" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path dams:lineage_role ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path dams:valid_to ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:string ;
            sh:description "Формат данных (например parquet, csv, json)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:data_format ],
        [ sh:description """Направление относительно решения. Запрещён для DataContainer и ExecutionAsset правилом DAMS-валидатора и LinkML rules.
""" ;
            sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path dams:direction ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 36 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:name ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:classification_source ],
        [ sh:description """Статус покрытия элемента mapping’ом на соседнем уровне модели (logical ↔ physical).
""" ;
            sh:in ( "mapped" "derived" "planned" "inherited" "technical-only" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:mapping_coverage_status ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 23 ;
            sh:path dams:governance_classification ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:solution_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path dams:aliases ],
        [ sh:class dams:ITSystem ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:system_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:PhysicalField ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:physical_fields ],
        [ sh:class dams:TechnicalAsset ;
            sh:description "Родитель в контейнерной иерархии (без циклов)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:parent_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path dams:description ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:technology ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:qualified_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:region ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path dams:policy_refs ],
        [ sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:in ( "relational_table" "relational_view" "file" "dataset" "stream_topic" "stream_queue" "message_type" "in_memory" "api_resource" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path dams:asset_kind ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование для planned / technical-only / not-applicable / inherited." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:mapping_rationale ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 39 ;
            sh:path dams:deprecated_by_ref ] ;
    sh:targetClass dams:DataCarrier .

dams:ScopedDefinition a sh:NodeShape ;
    rdfs:comment """Контекстное определение элемента модели (ADR-025 / ISO 11179 Context). Не является отдельным термином глоссария и не заменяет эталонное определение вне указанного scope.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Why this scoped wording differs from the reference definition." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:rationale ],
        [ sh:description """Target of the scope (e.g. ITSystem registry id). For scope_kind=system must be a member of the solution's ITSolution.member_system_refs.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:scope_ref ],
        [ sh:in ( "system" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:scope_kind ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:approval_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:scoped_definition_id ],
        [ sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:evidence_refs ],
        [ sh:datatype xsd:string ;
            sh:description "Scoped definition text (skos:definition in this context)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:text ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:approved_at ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:source_artifact_ref ],
        [ sh:in ( "refines" "narrows" "alternative" "replaces" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path dams:relation_to_reference ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:approved_by_ref ] ;
    sh:targetClass dams:ScopedDefinition .

dams:LogicalAttribute a sh:NodeShape ;
    rdfs:comment "Логический атрибут сущности с бизнес-смыслом, типом, обязательностью и классификацией." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
