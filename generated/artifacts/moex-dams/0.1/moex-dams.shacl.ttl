        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path dams:deprecated_by_ref ] ;
    sh:targetClass dams:PhysicalField .

dams:ConceptualDomain a sh:NodeShape ;
    rdfs:comment """Концептуальный домен значений: набор смыслов (ValueMeaning) или ссылка на внешнюю схему понятий. Допустим только в пакетах implementation_scope=enterprise.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:element_id ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:glossary_term_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:approved_at ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:data_owner_ref ],
        [ sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:evidence_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:title ],
        [ sh:class dams:ConceptualDomain ;
            sh:description "Более широкий концептуальный домен." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
