        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
