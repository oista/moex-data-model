dams:DomainContext a sh:NodeShape ;
    rdfs:comment "Ограниченный логический контекст с собственной терминологией и областью ответственности." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:BusinessDomain ;
            sh:maxCount 1 ;
