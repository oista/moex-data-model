        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:integrity_digest ;
            sh:pattern "^sha256:[a-fA-F0-9]{64}$" ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
