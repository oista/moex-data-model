    sh:targetClass dams:Dimension .

dams:ExecutionAsset a sh:NodeShape ;
    rdfs:comment """Исполняемый актив (pipeline / job) с минимальной lineage-ролью.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:name ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:native_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:classification_source ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:solution_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:qualified_name ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dams:aliases ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:data_owner_ref ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 17 ;
            sh:path dams:security_classification ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:in ( "pipeline" "job" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path dams:asset_kind ],
        [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:asset_namespace ],
        [ sh:class dams:ITSystem ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:system_ref ],
        [ sh:description "Роль актива в lineage (source, sink, intermediate, none)." ;
            sh:in ( "source" "sink" "intermediate" "none" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path dams:lineage_role ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:policy_refs ],
        [ sh:class dams:TechnicalAsset ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:consumes_refs ],
        [ sh:class dams:TechnicalAsset ;
            sh:description "Родитель в контейнерной иерархии (без циклов)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:parent_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:technology ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path dams:tags ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:owning_unit_ref ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path dams:governance_classification ],
        [ sh:description "Запрещён для ExecutionAsset (правило валидатора)." ;
            sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path dams:direction ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 29 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:TechnicalAsset ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:produces_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:classification_rationale ] ;
    sh:targetClass dams:ExecutionAsset .

dams:ExternalClassRef a sh:NodeShape ;
    rdfs:comment """Alignment of a ConceptualEntity to an external class or term (ADR-026). Canonical store for conceptual↔external links; Mapping(aligns_with) may mirror for ExternalTermSelection projections.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:source_artifact_ref ],
        [ sh:description "Optional ExternalTermSelection id (ADR-020)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:selection_ref ],
        [ sh:description """Alignment strength. exact/equivalent allow definition inheritance (ADR-025 / ADR-026); close/broad/narrow do not.
""" ;
            sh:in ( "exact" "equivalent" "close" "broad" "narrow" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 2 ;
            sh:path dams:match_kind ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:approval_status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:approved_at ],
        [ sh:description "IRI/CURIE of the external class or term (ADR-026)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:target_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:approved_by_ref ],
        [ sh:description "Optional ExternalSpecification / version pin (ADR-020)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:external_specification_ref ],
        [ sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:evidence_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:external_class_ref_id ],
        [ sh:description "Kind of external source (ontology, corp architecture, …)." ;
            sh:in ( "ontology" "corporate-architecture" "business-model" "api-spec" "other" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path dams:source_kind ] ;
    sh:targetClass dams:ExternalClassRef .

dams:FormalCheck a sh:NodeShape ;
    rdfs:comment "Одна машиночитаемая проверка требования. Kind выровнен с LinkML constraints и DAMS reference/structural diagnostics. formal_checks — исполняемое подмножество нормы; исполняется assess (ADR-013)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:target_slot ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:check_id ],
        [ sh:in ( "slot_required" "slot_min_cardinality" "ref_resolves" "key_subset" "at_least_one_slots" "definition_resolvable" "conditional_branch" "custom" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:kind ],
        [ sh:datatype xsd:string ;
            sh:description "Actionable remediation text for CI / Cursor / authors." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:remediation ],
        [ sh:datatype xsd:string ;
            sh:description "Имя класса LinkML (например LogicalEntity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:target_class ],
        [ sh:in ( "error" "warning" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 6 ;
            sh:path dams:severity ],
        [ sh:datatype xsd:string ;
            sh:description "Список слотов для kind=at_least_one_slots." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:target_slots ],
        [ sh:datatype xsd:string ;
            sh:description "JSON Pointer или path hint в теле ModelPackage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:target_path ],
        [ sh:datatype xsd:string ;
            sh:description "Мост к DAMS-STRUCT-* / DAMS-REF-* / DAMS-REQ-*." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:diagnostic_code ],
        [ sh:datatype xsd:string ;
            sh:description """Имя фиксированного шаблона для conditional_branch / custom (например ldm006_alignment, planned_on_active_warning).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:expression ] ;
    sh:targetClass dams:FormalCheck .

dams:Metric a sh:NodeShape ;
    rdfs:comment "Управляемое определение бизнес- или технической метрики; является опциональным аналитическим профилем." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:valid_from ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:owning_unit_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:unit ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:aggregation_function ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:description ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:LogicalAttribute ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:measure_attribute_refs ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 19 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:LogicalAttribute ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:dimension_attribute_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:filter_expression ],
        [ sh:class dams:LogicalEntity ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:grain_entity_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:metric_expression ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:name ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:policy_refs ] ;
    sh:targetClass dams:Metric .

dams:ModelPackage a sh:NodeShape ;
    rdfs:comment """Версионируемый артефакт модели данных: либо корпоративная conceptual модель (enterprise), либо модель конкретного ИТ-решения (solution). Package-level DAMS layer is dams_model_level on the SpecImpl envelope (ADR-021); implementation_scope here mirrors that body-level semantics.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:ExecutionAsset ;
            sh:description "Коллекция исполняемых активов пакета (Variant B, ADR-031)." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dams:execution_assets ],
        [ sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:imports_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:classification_source ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 39 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dams:owning_unit_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:DataStructure ;
            sh:description "Коллекция структур данных пакета." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:data_structures ],
        [ sh:class dams:BusinessDomain ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:domain_refs ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path dams:aliases ],
        [ sh:class dams:DataContainer ;
            sh:description "Коллекция контейнеров пакета (Variant B, ADR-031)." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:data_containers ],
        [ sh:class dams:DataType ;
            sh:description "Корпоративный реестр типов данных." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:data_types ],
        [ sh:class dams:ConceptualEntity ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:conceptual_entities ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path dams:policy_refs ],
        [ sh:description """Required for solution packages: reference to the enterprise-conceptual SpecImpl / ModelPackage id (e.g. moex-enterprise-conceptual-model).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:conceptual_implementation_ref ],
        [ sh:class dams:ValueDomain ;
            sh:description "Домены представления значений (enterprise или solution)." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:value_domains ],
        [ sh:class dams:NativeTypeBinding ;
            sh:description "Привязки нативных типов диалектов к DataType." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:native_type_bindings ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 41 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dams:data_owner_ref ],
        [ sh:description """Body-level scope: enterprise (no solution_ref) or solution. Must align with envelope dams_model_level when profile is dams-data-model.
""" ;
            sh:in ( "enterprise" "solution" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:implementation_scope ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path dams:classification_rationale ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 43 ;
            sh:path dams:valid_to ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 29 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 42 ;
            sh:path dams:valid_from ],
        [ sh:class dams:ConceptualDomain ;
            sh:description "Концептуальные домены смыслов (только enterprise-пакеты)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:conceptual_domains ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:solution_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:class dams:AccessPoint ;
            sh:description "Коллекция точек доступа пакета (Variant B, ADR-031)." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:access_points ],
        [ sh:class dams:Mapping ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dams:mappings ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path dams:name ],
        [ sh:class dams:RelationTerm ;
            sh:description "Governed relation-term dictionary for the package (ADR-026)." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:relation_terms ],
        [ sh:class dams:DataCarrier ;
            sh:description "Коллекция носителей данных пакета (Variant B, ADR-031)." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:data_carriers ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:api_version ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path dams:tags ],
        [ sh:class dams:Relationship ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:relationships ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 28 ;
            sh:path dams:governance_classification ],
        [ sh:class dams:Message ;
            sh:description "Коллекция сообщений пакета (интеграционная модель)." ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path dams:messages ],
        [ sh:class dams:ConceptualProperty ;
            sh:description "Значимые концептуальные свойства (только enterprise-пакеты)." ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:conceptual_properties ],
        [ sh:class dams:DomainContext ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:domain_contexts ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 44 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:model_version ;
            sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" ],
        [ sh:class dams:LogicalEntity ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:logical_entities ] ;
    sh:targetClass dams:ModelPackage .

dams:ModelSelection a sh:NodeShape ;
    rdfs:comment "Переиспользуемый набор выбранных сущностей, атрибутов и физических представлений." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:glossary_term_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:name ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path dams:lifecycle_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:element_id ],
        [ sh:class dams:SelectedEntity ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:selected_entities ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:title ] ;
    sh:targetClass dams:ModelSelection .

dams:NativeTypeBinding a sh:NodeShape ;
    rdfs:comment """Привязка нативного типа диалекта (SQL, JSON Schema и т.п.) к корпоративному DataType с оценкой потери точности.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Диалект/платформа нативного типа (postgresql, oracle, json, …)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:dialect ],
        [ sh:class dams:DataType ;
            sh:description "Ссылка на корпоративный DataType." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:data_type_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Описание отображения параметров (precision/scale/length)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:parameter_mapping ],
        [ sh:description "Оценка потери точности при отображении." ;
            sh:in ( "lossless" "lossy" "unknown" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 4 ;
            sh:path dams:lossiness ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:binding_id ],
        [ sh:datatype xsd:string ;
            sh:description """Имя нативного типа в диалекте. Отдельный слот от SchemaNode.native_type (другой контекст; общий URI ломает SchemaLoader merge — ADR-036).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:dialect_native_type ] ;
    sh:targetClass dams:NativeTypeBinding .

dams:PermissibleValue a sh:NodeShape ;
    rdfs:comment "Допустимое значение внутри ValueDomain (встраиваемый)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "Порядок значения в перечислении." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:ordinal ],
        [ sh:datatype xsd:string ;
            sh:description "Код значения, уникальный внутри ValueDomain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:value_code ],
        [ sh:datatype xsd:string ;
            sh:description "Определение допустимого значения." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:value_definition ],
        [ sh:datatype xsd:string ;
            sh:description "Метка допустимого значения." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:value_label ],
        [ sh:datatype xsd:string ;
            sh:description "Ключ ValueMeaning в связанном ConceptualDomain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:value_meaning_key ],
        [ sh:description "CURIE внешнего термина, уточняющего смысл." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:meaning_term_ref ],
        [ sh:description "Статус допустимого значения." ;
            sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path dams:value_status ] ;
    sh:targetClass dams:PermissibleValue .

dams:PolicyBinding a sh:NodeShape ;
    rdfs:comment "Применение управляемой политики к элементу модели." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path dams:approval_status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:valid_to ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:policy_binding_id ],
        [ sh:class dams:Policy ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:policy_ref ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:policy_target_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:valid_from ] ;
    sh:targetClass dams:PolicyBinding .

dams:RegistryEntry a sh:NodeShape ;
    rdfs:comment "Локальная ссылочная проекция записи внешней мастер-системы; не является мастер-копией справочника." ;
    sh:closed false ;
    sh:ignoredProperties ( dams:platform_ref rdf:type dams:member_system_refs dams:parent_domain_ref ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:master_system ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:registry_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:registry_name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:source_uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:registry_description ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dams:registry_status ] ;
    sh:targetClass dams:RegistryEntry .

dams:Relationship a sh:NodeShape ;
    rdfs:comment "Именованная связь между логическими или концептуальными сущностями." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:target_min_cardinality ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:glossary_term_refs ],
        [ sh:description "Тип логической связи (Wave 2)." ;
            sh:in ( "association" "composition" "aggregation" "specialization" "reference" "derivation" "realization" "lineage" "event_participation" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path dams:relationship_kind ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:identifying ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dams:name ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:target_entity_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:source_role ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:target_role ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:source_min_cardinality ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dams:element_id ],
        [ sh:description """Whether this Relationship assertion uses the forward or inverse wording of relation_term_ref (ADR-026). Default forward when omitted.
""" ;
            sh:in ( "forward" "inverse" ) ;
            sh:maxCount 1 ;
            sh:order 13 ;
            sh:path dams:term_direction ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:source_max_cardinality ],
        [ sh:class dams:RelationTerm ;
            sh:description """Reference to a governed RelationTerm providing forward/inverse labels (ADR-026). One Relationship record per pair; labels are derived.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:relation_term_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:valid_from ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 21 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:target_max_cardinality ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:valid_to ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:source_entity_ref ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:associative ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование отсутствия кардинальности для draft/imported связей." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:cardinality_rationale ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:title ] ;
    sh:targetClass dams:Relationship .

dams:RequirementApplicability a sh:NodeShape ;
    rdfs:comment """Область применимости требования (без graph queries): класс цели, профиль и уровень модели.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Stable id for applies_to blocks (e.g. appl:LDM-001)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:applicability_id ],
        [ sh:in ( "enterprise-conceptual" "solution" ) ;
            sh:maxCount 1 ;
            sh:order 4 ;
            sh:path dams:applies_dams_model_level ],
        [ sh:in ( "dams-data-model" "ontology-application" "api-specification" "data-contract" "other" ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path dams:applies_implementation_profile ],
        [ sh:datatype xsd:string ;
            sh:description "Опциональный allowlist asset_kind / facet (например relational_table, stream_topic)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:applies_target_kinds ],
        [ sh:in ( "enterprise" "solution" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path dams:applies_implementation_scope ],
        [ sh:datatype xsd:string ;
            sh:description "Имя класса LinkML, к экземплярам которого применяется требование." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:applies_target_class ] ;
    sh:targetClass dams:RequirementApplicability .

dams:SchemaNode a sh:NodeShape ;
    rdfs:comment """Узел дерева структуры. Идентичность (DataStructure.element_id, local_key). Рёбра children/item_node — строки local_key (плоская форма, ADR-038). Форма и физика в одном узле (как ODCS).
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "local_key узла элемента массива или значения map." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:item_node ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:native_type ],
        [ sh:datatype xsd:integer ;
            sh:description "Минимальная кратность." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:min_occurs ],
        [ sh:description """Статус покрытия элемента mapping’ом на соседнем уровне модели (logical ↔ physical).
""" ;
            sh:in ( "mapped" "derived" "planned" "inherited" "technical-only" "not-applicable" ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path dams:mapping_coverage_status ],
        [ sh:description "Цель внешнего ключа как structure_id#local_key (только relational)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:foreign_key_target ],
        [ sh:datatype xsd:boolean ;
            sh:description "Признак первичного ключа (только relational; DAMS-валидатор)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:is_primary_key ],
        [ sh:datatype xsd:string ;
            sh:description "Обоснование для planned / technical-only / not-applicable / inherited." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:mapping_rationale ],
        [ sh:datatype xsd:integer ;
            sh:description "Позиция колонки (только schema_format=relational; DAMS-валидатор)." ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:column_position ],
        [ sh:datatype xsd:integer ;
            sh:description "Максимальная кратность; без верхней границы слот отсутствует." ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:max_occurs ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:ordinal_position ],
        [ sh:class dams:LogicalAttribute ;
            sh:description "Опциональная связь с логическим атрибутом (как concept_ref)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:realizes_attribute_ref ],
        [ sh:class dams:DataType ;
            sh:description "Ссылка на корпоративный DataType." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:data_type_ref ],
        [ sh:datatype xsd:boolean ;
            sh:description "Признак уникальности колонки (только relational; DAMS-валидатор)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:is_unique ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:default_value ],
        [ sh:datatype xsd:string ;
            sh:description """Локальный ключ узла внутри DataStructure. Алфавит ^[a-z0-9_.-]+$ (ADR-039). Стабилен после записи; не пересчитывается при смене native_name.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:local_key ;
            sh:pattern "^[a-z0-9_.-]+$" ],
        [ sh:datatype xsd:boolean ;
            sh:description "Допустимость null (отдельно от required)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:nullable ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:required ],
        [ sh:description "Вид узла (scalar, object, array, map, union, enum, reference)." ;
            sh:in ( "scalar" "object" "array" "map" "union" "enum" "reference" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:node_kind ],
        [ sh:datatype xsd:string ;
            sh:description "local_key дочерних узлов (object / union)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:children ],
        [ sh:description "Цель для node_kind=reference (другая DataStructure или узел)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:reference_target ],
        [ sh:datatype xsd:string ;
            sh:description "Временные выражения ограничений до введения Expression." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:constraint_expressions ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:native_name ] ;
    sh:targetClass dams:SchemaNode .

dams:SelectedAttribute a sh:NodeShape ;
    rdfs:comment "Выбранный атрибут и соответствующее физическое поле payload, таблицы или сообщения." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:name ],
        [ sh:description "Ссылки на узлы схемы (SchemaNode) в DataStructure." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:schema_node_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:LogicalAttribute ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:logical_attribute_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:tags ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:Mapping ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:transformation_mapping_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:title ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:element_id ] ;
    sh:targetClass dams:SelectedAttribute .

dams:SelectedEntity a sh:NodeShape ;
    rdfs:comment "Выбранная для интеграции логическая сущность." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:title ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:LogicalEntity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:logical_entity_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:valid_from ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 10 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:tags ],
        [ sh:class dams:SelectedAttribute ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:selected_attributes ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:name ],
        [ sh:class dams:DataCarrier ;
            sh:description "Носители данных, участвующие в binding (не контейнеры)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:carrier_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:valid_to ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:element_id ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:description ] ;
    sh:targetClass dams:SelectedEntity .

dams:ValueMeaning a sh:NodeShape ;
    rdfs:comment """Смысл допустимого значения внутри ConceptualDomain (встраиваемый, без lifecycle).
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Ключ более широкого ValueMeaning в том же домене." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:broader_meaning_key ],
        [ sh:description "Статус смысла значения." ;
            sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path dams:meaning_status ],
        [ sh:datatype xsd:string ;
            sh:description "Предпочтительная метка смысла (skos:prefLabel в OWL-проекции)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:meaning_label ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:description "Определение смысла (skos:definition)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:meaning_definition ],
        [ sh:description "CURIE внешнего термина, уточняющего смысл." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:meaning_term_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Ключ смысла, уникальный внутри ConceptualDomain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:meaning_key ] ;
    sh:targetClass dams:ValueMeaning .

dams:ValueSetQuery a sh:NodeShape ;
    rdfs:comment """Динамический запрос набора значений по образцу LinkML reachable_from (source ontology, узлы, типы связей).
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Типы связей для обхода." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:relationship_types ],
        [ sh:datatype xsd:string ;
            sh:description "Локальный идентификатор динамического запроса внутри ValueDomain." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:value_set_query_id ],
        [ sh:datatype xsd:boolean ;
            sh:description "Включать стартовые узлы в результат." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:include_self ],
        [ sh:description "Стартовые узлы reachable_from." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:source_nodes ],
        [ sh:description "IRI/CURIE исходной онтологии для динамического набора." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:source_ontology ] ;
    sh:targetClass dams:ValueSetQuery .

dams:AccessPoint a sh:NodeShape ;
    rdfs:comment """Точка доступа к данным: интерфейс, операция или канал. Сама данные не несёт; указывает на носители через serves_refs.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 40 ;
            sh:path dams:valid_to ],
        [ sh:description "Направление протокола AccessPoint (через FlowDirectionEnum)." ;
            sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 19 ;
            sh:path dams:direction ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:region ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 36 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:native_name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:location_uri ],
        [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:asset_namespace ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:protocol_version ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 26 ;
            sh:path dams:security_classification ],
        [ sh:class dams:Message ;
            sh:description """Сообщения точки доступа. Допустимо для AccessPoint kind=operation|channel; запрещено для interface (LinkML rule + DAMS).
""" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:message_refs ],
        [ sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:in ( "interface" "operation" "channel" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 17 ;
            sh:path dams:asset_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dams:classification_rationale ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
