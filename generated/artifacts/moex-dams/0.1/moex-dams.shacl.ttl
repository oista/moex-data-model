            sh:order 5 ;
            sh:path dams:master_system ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:registry_name ],
        [ sh:class dams:ITSystem ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:member_system_refs ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:registry_id ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:source_uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:registry_description ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:registry_status ] ;
    sh:targetClass dams:ITSolution .

dams:DataClassificationTerm a sh:NodeShape ;
