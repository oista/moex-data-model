        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:required ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dams:tags ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:element_id ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
