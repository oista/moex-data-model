@prefix dams: <https://data.moex.com/dams/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dams:Contains a sh:NodeShape ;
    rdfs:comment """Mixin контейнерности. child_refs не хранятся: выводятся из parent_ref.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "composite" "partitioned" "hierarchical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:containment_kind ] ;
    sh:targetClass dams:Contains .

dams:HasBusinessClassification a sh:NodeShape ;
    rdfs:comment "Классификация роли и бизнес-значимости логической сущности." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "critical" "high" "medium" "low" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:business_importance ],
        [ sh:in ( "core" "derived" "reference" "projection" "technical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:entity_type ],
        [ sh:in ( "reference_data" "master_data" "transactional_data" "analytical_data" "metadata" "operational_data" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:data_class ] ;
    sh:targetClass dams:HasBusinessClassification .

dams:HasDefinition a sh:NodeShape ;
    rdfs:comment """Mixin эталонного определения (ADR-025). Слот description остаётся skos:definition (own text). Отсутствие description при наличии definition_source_ref означает наследование; заданный description — own (опционально adapted from source). scoped_definitions — контекстные определения (v1: уровень ITSystem), не заменяющие эталон вне scope.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:scoped_definitions ],
        [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:definition_rationale ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:definition_source_ref ] ;
    sh:targetClass dams:HasDefinition .

dams:HasGovernanceClassification a sh:NodeShape ;
    rdfs:comment """Базовая и специальная классификация чувствительности данных. governance_classification участвует в containment cascade (ADR-023): пустой слот наследуется от родителя, заданный — override.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:classification_source ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:governance_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:classification_rationale ] ;
    sh:targetClass dams:HasGovernanceClassification .

dams:HasLifecycle a sh:NodeShape ;
    rdfs:comment "Mixin жизненного цикла: статус, период действия и ссылка на заменяющий элемент." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:valid_from ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:valid_to ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path dams:lifecycle_status ] ;
    sh:targetClass dams:HasLifecycle .

dams:HasLocation a sh:NodeShape ;
    rdfs:comment "Mixin расположения носителя или точки доступа." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:region ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:location_uri ] ;
    sh:targetClass dams:HasLocation .

dams:HasOwnership a sh:NodeShape ;
    rdfs:comment """Mixin владения: data owner, data steward и организационное подразделение. Отсутствие слота означает наследование эффективного значения по containment cascade (ADR-023); заданное значение — локальный override.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:data_owner_ref ] ;
    sh:targetClass dams:HasOwnership .

dams:HasPolicyBindings a sh:NodeShape ;
    rdfs:comment """Mixin привязки управляемых политик к элементу модели. policy_refs участвует в containment cascade (ADR-023): отсутствие ключа — наследование; присутствующий список (в т.ч. пустой) — полная замена.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:policy_refs ] ;
    sh:targetClass dams:HasPolicyBindings .

dams:HasProtocolBinding a sh:NodeShape ;
    rdfs:comment "Mixin протокола доступа для точки доступа (AccessPoint)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "Ссылка на внешнее описание binding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:binding_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:protocol_version ],
        [ sh:datatype xsd:string ;
            sh:description "Протокол доступа (например https, jdbc, kafka)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:protocol ] ;
    sh:targetClass dams:HasProtocolBinding .

dams:HasProvenance a sh:NodeShape ;
    rdfs:comment "Mixin происхождения и согласования: исходный артефакт, evidence, статус и согласующий." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:approved_by_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:approved_at ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:source_artifact_ref ],
        [ sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:evidence_refs ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:approval_status ] ;
    sh:targetClass dams:HasProvenance .

dams:HasStructure a sh:NodeShape ;
    rdfs:comment """Mixin структуры данных носителя. structure_ref — временная ссылка (uriorcurie); в будущем заменяется классом DataStructure (ADR-C).
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Диалект схемы (например avro, json-schema, sql-ddl)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:schema_dialect ],
        [ sh:datatype xsd:string ;
            sh:description "Формат данных (например parquet, csv, json)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:data_format ],
        [ sh:description """Ссылка на структуру данных (пока uriorcurie; в будущем DataStructure).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:structure_ref ] ;
    sh:targetClass dams:HasStructure .

dams:MOEXModelRepository a sh:NodeShape ;
    rdfs:comment "Корневой контейнер для проверки набора моделей, ссылочных проекций справочников, потоков и контрактных bindings." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:repository_id ],
        [ sh:class dams:DataFlow ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:data_flows ],
        [ sh:class dams:Metric ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:metrics ],
        [ sh:class dams:ClassificationAssignment ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:classification_assignments ],
        [ sh:class dams:PolicyBinding ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:policy_bindings ],
        [ sh:class dams:ModelPackage ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:model_packages ],
        [ sh:class dams:RegistryEntry ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:registry_entries ],
        [ sh:class dams:DataModelBinding ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:data_model_bindings ],
        [ sh:class dams:Dimension ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:dimensions ] ;
    sh:targetClass dams:MOEXModelRepository .

dams:ModelElement a sh:NodeShape ;
    rdfs:comment "Абстрактный корень иерархии элементов модели: общая идентичность (element_id), имя, описание и жизненный цикл." ;
    sh:closed false ;
    sh:ignoredProperties ( dams:conceptual_domain_ref dams:unit_code dams:ownership_inheritance_rule dams:permissible_values dams:imports_refs dams:classification_rationale dams:technology dams:protocol_version dams:business_key_kind dams:datatype_timezone_policy dams:owner_entity_ref dams:requirement_level dams:key_attribute_refs dams:solution_data_role dams:critical_data_element dams:contract_ref dams:identifying dams:definition_source_ref dams:property_owner_entity_ref dams:default_value dams:conceptual_entities dams:requirement_section dams:approved_by_ref dams:currency_attribute_ref dams:derived_expression dams:source_role dams:evidence_refs dams:logical_entities dams:containment_kind dams:mappings dams:flow_ref dams:execution_assets dams:term_direction dams:policy_refs dams:target_system_ref dams:definition_rationale dams:owning_unit_ref dams:source_entity_ref dams:transformation_ref dams:system_ref dams:mapping_type dams:integration_level dams:source_refs dams:lineage_role dams:source_solution_ref dams:binding_ref dams:parent_concept_ref dams:forward_label_en dams:asset_kind dams:serves_refs dams:max_value dams:transformation_mapping_ref dams:depends_on_refs dams:classification_source dams:model_version dams:significance_rationale dams:type_family dams:api_version dams:relation_terms dams:sensitivity_term_refs dams:native_name dams:property_kind dams:produces_refs dams:source_model_ref dams:precision dams:value_set_ref dams:business_process_refs dams:asset_namespace dams:measure_attribute_refs dams:target_role dams:selected_attributes dams:ordinal_position dams:logical_entity_ref rdf:type dams:operation_name dams:statement dams:conceptual_domains dams:multivalued dams:metric_expression dams:consumes_refs dams:format_pattern dams:identity_rule dams:superseded_by dams:data_owner_ref dams:generated_at dams:conceptual_entity_refs dams:physical_field_refs dams:entity_type dams:structure_ref dams:integration_class dams:symmetric dams:domain_contexts dams:path_template dams:value_set_source dams:source_system_ref dams:data_format dams:unit dams:integration_ref dams:domain_ref dams:entity_tier dams:data_containers dams:transformation_mapping_refs dams:external_class_refs dams:aggregation_function dams:data_steward_ref dams:integration_channel dams:source_min_cardinality dams:mapping_coverage_status dams:attributes dams:source_max_cardinality dams:location_uri dams:forward_label dams:base_type_ref dams:entity_bindings dams:maximum_cardinality dams:carrier_ref dams:namespace dams:relationship_kind dams:governance_classification dams:logical_attribute_ref dams:implementation_status dams:data_class dams:conceptual_alignment_status dams:qualified_name dams:target_max_cardinality dams:data_carriers dams:type_name dams:target_solution_ref dams:security_classification dams:carrier_refs dams:isolation_rationale dams:min_value dams:target_platform_ref dams:protocol dams:logical_attribute_refs dams:source_platform_ref dams:relation_term_ref dams:mapping_cardinality dams:approved_at dams:approval_status dams:is_identifying dams:formal_checks dams:confidence dams:min_length dams:linkml_type dams:logical_type dams:implementation_scope dams:concept_ref dams:temporal_semantics dams:direction dams:native_type_bindings dams:value_domain_kind dams:integration_spec_ref dams:compatibility_mode dams:parent_ref dams:required dams:applies_to dams:conceptual_implementation_ref dams:domain_refs dams:region dams:significance_basis dams:business_importance dams:solution_ref dams:compatibility_baseline_ref dams:minimum_cardinality dams:data_type_ref dams:selections dams:scale dams:filter_expression dams:model_package_ref dams:xsd_datatype dams:http_method dams:inverse_label dams:broader_domain_ref dams:relationships dams:access_points dams:value_meanings dams:genesis_kind dams:value_domain_ref dams:transformation_expression dams:integrity_digest dams:dynamic_query dams:physical_fields dams:ontology_property_ref dams:schema_dialect dams:target_min_cardinality dams:alignment_rationale dams:native_type dams:associative dams:timezone_policy dams:default_relationship_kind dams:schema_path dams:context_ref dams:concept_scheme_uri dams:specification_version dams:target_entity_ref dams:conceptual_properties dams:dimension_attribute_refs dams:inverse_label_en dams:mapping_rationale dams:max_length dams:target_refs dams:implementation_version dams:scoped_definitions dams:invariant_refs dams:selected_entities dams:value_domains dams:source_artifact_ref dams:grain_entity_refs dams:charset dams:conceptual_domain_kind dams:data_types dams:interface_ref dams:model_revision dams:code dams:dependency_kind dams:cardinality_rationale ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:description ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:valid_from ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:name ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:title ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:lifecycle_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:element_id ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:deprecated_by_ref ] ;
    sh:targetClass dams:ModelElement .

dams:RequirementCatalog a sh:NodeShape ;
    rdfs:comment "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:catalog_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:name ],
        [ sh:class dams:SpecificationRequirement ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:requirements ] ;
    sh:targetClass dams:RequirementCatalog .

dams:BusinessProcess a sh:NodeShape ;
    rdfs:comment "Ссылка на бизнес-процесс или его шаг в BPMN-репозитории." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:registry_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:master_system ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dams:registry_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:registry_description ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:source_uri ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:registry_id ] ;
    sh:targetClass dams:BusinessProcess .

dams:ClassificationAssignment a sh:NodeShape ;
    rdfs:comment "Версионируемое назначение категории классификации элементу модели с основанием и периодом действия." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:valid_to ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path dams:governance_classification ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:approval_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:classification_rationale ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:valid_from ],
        [ sh:class dams:DataClassificationTerm ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:classification_term_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:classification_source ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:classified_element_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:assignment_id ] ;
    sh:targetClass dams:ClassificationAssignment .

dams:DataContainer a sh:NodeShape ;
    rdfs:comment """Контейнер других активов (database, schema, bucket, broker, directory, cluster). Данных не несёт: structure_ref и data_format отсутствуют.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:asset_namespace ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 28 ;
            sh:path dams:lifecycle_status ],
        [ sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:in ( "database" "schema" "bucket" "broker" "directory" "cluster" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:asset_kind ],
        [ sh:class dams:TechnicalAsset ;
            sh:description "Родитель в контейнерной иерархии (без циклов)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:parent_ref ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:technology ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:qualified_name ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:name ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:valid_to ],
        [ sh:in ( "composite" "partitioned" "hierarchical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:containment_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:classification_source ],
        [ sh:description "Роль актива в lineage (source, sink, intermediate, none)." ;
            sh:in ( "source" "sink" "intermediate" "none" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:lineage_role ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
