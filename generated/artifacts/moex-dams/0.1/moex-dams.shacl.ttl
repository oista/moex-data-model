            sh:order 25 ;
            sh:path dams:aliases ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:native_name ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:tags ],
