            sh:order 14 ;
            sh:path dams:name ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 10 ;
            sh:path dams:approval_status ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:aliases ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 20 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:ValueMeaning ;
            sh:description "Встроенный список смыслов значений." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path dams:value_meanings ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:data_steward_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:tags ],
        [ sh:description "Вид концептуального домена (enumerated | described)." ;
            sh:in ( "enumerated" "described" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path dams:conceptual_domain_kind ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:approved_by_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
