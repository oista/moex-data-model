        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path dams:description ] ;
    sh:targetClass dams:AccessPoint .

dams:DataContractReference a sh:NodeShape ;
