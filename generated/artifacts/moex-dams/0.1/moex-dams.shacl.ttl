            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:binding_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path dams:name ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dams:owning_unit_ref ],
        [ sh:class dams:DataCarrier ;
