@prefix dams: <https://data.moex.com/dams/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dams:Contains a sh:NodeShape ;
    rdfs:comment """Mixin контейнерности. child_refs не хранятся: выводятся из parent_ref.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "composite" "partitioned" "hierarchical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:containment_kind ] ;
    sh:targetClass dams:Contains .

dams:EmbeddedElement a sh:NodeShape ;
    rdfs:comment """Встраиваемый вспомогательный объект без собственного жизненного цикла и глобального element_id. Идентичность локальна относительно родителя (local_key). Не путать с будущим IdentifiedElement (ADR-038).
""" ;
    sh:closed false ;
    sh:ignoredProperties ( dams:node_kind dams:native_name dams:nullable dams:mapping_coverage_status dams:constraint_expressions dams:min_occurs dams:native_type rdf:type dams:required dams:children dams:foreign_key_target dams:realizes_attribute_ref dams:item_node dams:data_type_ref dams:column_position dams:default_value dams:is_primary_key dams:ordinal_position dams:is_unique dams:reference_target dams:max_occurs dams:mapping_rationale ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:description """Локальный ключ узла внутри DataStructure. Алфавит ^[a-z0-9_.-]+$ (ADR-039). Стабилен после записи; не пересчитывается при смене native_name.
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:local_key ] ;
    sh:targetClass dams:EmbeddedElement .

dams:HasBusinessClassification a sh:NodeShape ;
    rdfs:comment "Классификация роли и бизнес-значимости логической сущности." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "reference_data" "master_data" "transactional_data" "analytical_data" "metadata" "operational_data" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:data_class ],
        [ sh:in ( "critical" "high" "medium" "low" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:business_importance ],
        [ sh:in ( "core" "derived" "reference" "projection" "technical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:entity_type ] ;
    sh:targetClass dams:HasBusinessClassification .

dams:HasDefinition a sh:NodeShape ;
    rdfs:comment """Mixin эталонного определения (ADR-025). Слот description остаётся skos:definition (own text). Отсутствие description при наличии definition_source_ref означает наследование; заданный description — own (опционально adapted from source). scoped_definitions — контекстные определения (v1: уровень ITSystem), не заменяющие эталон вне scope.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Human rationale for declaring an own definition when a source is also cited, or for overriding an inherited definition.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:definition_rationale ],
        [ sh:class dams:ScopedDefinition ;
            sh:description "Context-scoped definitions (ADR-025); v1 scope_kind = system." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:scoped_definitions ],
        [ sh:description """Reference to the element or external term whose definition is inherited or adapted (ADR-025). Orthogonal to glossary_term_refs (term assignment).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:definition_source_ref ] ;
    sh:targetClass dams:HasDefinition .

dams:HasGovernanceClassification a sh:NodeShape ;
    rdfs:comment """Базовая и специальная классификация чувствительности данных. governance_classification участвует в containment cascade (ADR-023): пустой слот наследуется от родителя, заданный — override.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:governance_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:classification_source ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:classification_rationale ] ;
    sh:targetClass dams:HasGovernanceClassification .

dams:HasLifecycle a sh:NodeShape ;
    rdfs:comment "Mixin жизненного цикла: статус, период действия и ссылка на заменяющий элемент." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path dams:lifecycle_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:valid_to ] ;
    sh:targetClass dams:HasLifecycle .

dams:HasLocation a sh:NodeShape ;
    rdfs:comment "Mixin расположения носителя или точки доступа." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:region ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:location_uri ] ;
    sh:targetClass dams:HasLocation .

dams:HasOwnership a sh:NodeShape ;
    rdfs:comment """Mixin владения: data owner, data steward и организационное подразделение. Отсутствие слота означает наследование эффективного значения по containment cascade (ADR-023); заданное значение — локальный override.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:owning_unit_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:ownership_inheritance_rule ] ;
    sh:targetClass dams:HasOwnership .

dams:HasPolicyBindings a sh:NodeShape ;
    rdfs:comment """Mixin привязки управляемых политик к элементу модели. policy_refs участвует в containment cascade (ADR-023): отсутствие ключа — наследование; присутствующий список (в т.ч. пустой) — полная замена.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:policy_refs ] ;
    sh:targetClass dams:HasPolicyBindings .

dams:HasProtocolBinding a sh:NodeShape ;
    rdfs:comment "Mixin протокола доступа для точки доступа (AccessPoint)." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Протокол доступа (например https, jdbc, kafka)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:protocol ],
        [ sh:description "Ссылка на внешнее описание binding." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:binding_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:protocol_version ] ;
    sh:targetClass dams:HasProtocolBinding .

dams:HasProvenance a sh:NodeShape ;
    rdfs:comment "Mixin происхождения и согласования: исходный артефакт, evidence, статус и согласующий." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:approval_status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:approved_at ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:approved_by_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:source_artifact_ref ],
        [ sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:evidence_refs ] ;
    sh:targetClass dams:HasProvenance .

dams:HasStructure a sh:NodeShape ;
    rdfs:comment """Mixin структуры данных носителя. structure_ref — ссылка на DataStructure (range=DataStructure, ADR-038). Диалект схемы живёт на DataStructure.schema_dialect.
""" ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:DataStructure ;
            sh:description """Ссылка на структуру данных (DataStructure, ADR-038).
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:structure_ref ],
        [ sh:datatype xsd:string ;
            sh:description "Wire-формат носителя (parquet, csv, json); не путать с schema_format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:data_format ] ;
    sh:targetClass dams:HasStructure .

dams:MOEXModelRepository a sh:NodeShape ;
    rdfs:comment "Корневой контейнер для проверки набора моделей, ссылочных проекций справочников, потоков и контрактных bindings." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:PolicyBinding ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:policy_bindings ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:repository_id ],
        [ sh:class dams:ModelPackage ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:model_packages ],
        [ sh:class dams:DataFlow ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:data_flows ],
        [ sh:class dams:RegistryEntry ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:registry_entries ],
        [ sh:class dams:Dimension ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:dimensions ],
        [ sh:class dams:ClassificationAssignment ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:classification_assignments ],
        [ sh:class dams:DataModelBinding ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:data_model_bindings ],
        [ sh:class dams:Metric ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:metrics ] ;
    sh:targetClass dams:MOEXModelRepository .

dams:ModelElement a sh:NodeShape ;
    rdfs:comment "Абстрактный корень иерархии элементов модели: общая идентичность (element_id), имя, описание и жизненный цикл." ;
    sh:closed false ;
    sh:ignoredProperties ( dams:namespace dams:data_steward_ref dams:cardinality_rationale dams:serves_refs dams:charset dams:applies_to dams:produces_refs dams:previous_version_ref dams:payload_structure_ref dams:unit_code dams:filter_expression dams:currency_attribute_ref dams:type_family dams:sensitivity_term_refs dams:default_value dams:location_uri dams:headers_structure_ref dams:consumes_refs dams:model_version dams:ownership_inheritance_rule dams:mappings dams:classification_source dams:invariant_refs dams:owning_unit_ref dams:model_revision dams:dependency_kind dams:entity_tier dams:concept_ref dams:integration_ref dams:data_carriers dams:conceptual_implementation_ref dams:requirement_level dams:mapping_type dams:envelope_ref dams:implementation_scope dams:selected_attributes dams:property_kind dams:implementation_status dams:inverse_label_en dams:target_entity_ref dams:protocol dams:selections dams:model_package_ref dams:asset_namespace dams:symmetric dams:evidence_refs dams:definition_source_ref dams:implementation_version dams:target_refs dams:data_format dams:timezone_policy dams:attributes dams:native_name dams:protocol_version dams:significance_basis dams:source_artifact_ref dams:critical_data_element dams:integration_spec_ref dams:base_type_ref dams:lineage_role dams:parent_concept_ref dams:content_type dams:data_owner_ref dams:messages dams:measure_attribute_refs dams:compatibility_baseline_ref dams:logical_entity_ref dams:data_class dams:scoped_definitions dams:logical_attribute_refs dams:classification_rationale dams:schema_node_refs dams:conceptual_domain_kind dams:business_importance dams:max_value dams:concept_scheme_uri dams:target_role dams:api_version dams:precision dams:conceptual_domains dams:solution_data_role dams:integration_level dams:business_process_refs dams:dimension_attribute_refs dams:requirement_section dams:source_pointer dams:relationship_kind dams:schema_dialect dams:associative dams:multivalued dams:format_pattern dams:required dams:transformation_mapping_refs dams:superseded_by dams:key_attribute_refs dams:system_ref dams:source_model_ref dams:confidence dams:domain_contexts dams:ontology_property_ref dams:data_type_ref dams:operation_name dams:transformation_expression dams:integration_class dams:target_platform_ref dams:identity_rule dams:conceptual_alignment_status dams:message_refs dams:schema_format dams:approval_status dams:mapping_cardinality dams:asset_kind dams:target_system_ref dams:selected_entities dams:data_containers dams:approved_by_ref dams:xsd_datatype dams:mapping_coverage_status dams:entity_type dams:type_name dams:derived_expression dams:content_digest dams:containment_kind dams:data_structures dams:access_points dams:inverse_label dams:structure_ref dams:flow_ref dams:compatibility_mode dams:transformation_mapping_ref dams:alignment_rationale dams:genesis_kind dams:specification_version dams:integration_channel dams:region dams:http_method dams:metric_expression dams:nodes dams:conceptual_entities dams:logical_entities dams:forward_label_en dams:binding_ref dams:conceptual_entity_refs dams:technology dams:value_meanings dams:execution_assets dams:value_domain_kind dams:domain_ref dams:is_identifying dams:aggregation_function dams:broader_domain_ref rdf:type dams:identifying dams:security_classification dams:path_template dams:source_entity_ref dams:interface_ref dams:source_refs dams:transformation_ref dams:definition_rationale dams:source_max_cardinality dams:imports_refs dams:native_type_bindings dams:approved_at dams:default_relationship_kind dams:direction dams:relationships dams:solution_ref dams:logical_attribute_ref dams:unit dams:mapping_rationale dams:context_ref dams:value_domains dams:data_types dams:target_max_cardinality dams:linkml_type dams:permissible_values dams:envelope_kind dams:governance_classification dams:source_platform_ref dams:dynamic_query dams:generated_at dams:business_key_kind dams:source_role dams:source_min_cardinality dams:structure_version dams:target_min_cardinality dams:integrity_digest dams:conceptual_properties dams:external_class_refs dams:min_length dams:target_solution_ref dams:source_solution_ref dams:temporal_semantics dams:max_length dams:root_local_key dams:depends_on_refs dams:owner_entity_ref dams:correlation_hint dams:source_system_ref dams:formal_checks dams:policy_refs dams:maximum_cardinality dams:entity_bindings dams:code dams:relation_terms dams:carrier_refs dams:term_direction dams:minimum_cardinality dams:isolation_rationale dams:forward_label dams:property_owner_entity_ref dams:relation_term_ref dams:value_set_source dams:grain_entity_refs dams:value_domain_ref dams:significance_rationale dams:scale dams:conceptual_domain_ref dams:parent_ref dams:datatype_timezone_policy dams:contract_ref dams:qualified_name dams:min_value dams:statement dams:domain_refs ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:valid_from ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:element_id ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:name ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:description ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:deprecated_by_ref ] ;
    sh:targetClass dams:ModelElement .

dams:RequirementCatalog a sh:NodeShape ;
    rdfs:comment "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:name ],
        [ sh:class dams:SpecificationRequirement ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:requirements ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:catalog_id ] ;
    sh:targetClass dams:RequirementCatalog .

dams:BusinessProcess a sh:NodeShape ;
    rdfs:comment "Ссылка на бизнес-процесс или его шаг в BPMN-репозитории." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dams:registry_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:registry_description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:master_system ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:source_uri ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:registry_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:registry_name ] ;
    sh:targetClass dams:BusinessProcess .

dams:ClassificationAssignment a sh:NodeShape ;
    rdfs:comment "Версионируемое назначение категории классификации элементу модели с основанием и периодом действия." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:classification_rationale ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path dams:governance_classification ],
        [ sh:class dams:DataClassificationTerm ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:classification_term_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:classification_source ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:valid_to ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:approval_status ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:classified_element_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:assignment_id ] ;
    sh:targetClass dams:ClassificationAssignment .

dams:DataContainer a sh:NodeShape ;
    rdfs:comment """Контейнер других активов (database, schema, bucket, broker, directory, cluster). Данных не несёт: structure_ref и data_format отсутствуют.
""" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dams:element_id ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:qualified_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dams:description ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:owning_unit_ref ],
        [ sh:datatype xsd:string ;
            sh:description """Deprecated as source of truth (ADR-023). Human-readable rationale for ownership inheritance/override only; does not substitute data_owner_ref. Effective ownership is resolved by the containment cascade.
""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:ownership_inheritance_rule ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dams:aliases ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 28 ;
            sh:path dams:lifecycle_status ],
        [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dams:policy_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:name ],
        [ sh:in ( "composite" "partitioned" "hierarchical" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:containment_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path dams:classification_rationale ],
        [ sh:description "Роль актива в lineage (source, sink, intermediate, none)." ;
            sh:in ( "source" "sink" "intermediate" "none" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:lineage_role ],
        [ sh:class dams:ITSystem ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:system_ref ],
        [ sh:description "Запрещён для DataContainer (правило валидатора)." ;
            sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:order 9 ;
            sh:path dams:direction ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 15 ;
            sh:path dams:governance_classification ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:description """Пространство имён источника по аналогии с OpenLineage namespace (например postgres://host:5432, kafka://cluster, s3://bucket). Отдельный слот от DomainContext.namespace (ADR-B).
""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:asset_namespace ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:valid_to ],
        [ sh:description """Разновидность актива. На подклассах сужается через slot_usage на соответствующий enum.
""" ;
            sh:in ( "database" "schema" "bucket" "broker" "directory" "cluster" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:asset_kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:native_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:technology ],
        [ sh:class dams:ITSolution ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:solution_ref ],
        [ sh:class dams:TechnicalAsset ;
            sh:description "Родитель в контейнерной иерархии (без циклов)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:parent_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dams:classification_source ] ;
    sh:targetClass dams:DataContainer .

dams:DataFlowEntityBinding a sh:NodeShape ;
