            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:unit_code ],
        [ sh:description "Режим защиты (Wave 2); ортогонален governance_classification." ;
            sh:in ( "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 21 ;
            sh:path dams:security_classification ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path dams:tags ],
        [ sh:in ( "string" "integer" "decimal" "boolean" "date" "datetime" "time" "binary" "identifier" "uri" "object" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:logical_type ],
        [ sh:class dams:LogicalEntity ;
            sh:description """Structural parent LogicalEntity of this attribute (containment), not the data owner role. Data ownership uses data_owner_ref via HasOwnership / ADR-023 cascade.
""" ;
            sh:maxCount 1 ;
