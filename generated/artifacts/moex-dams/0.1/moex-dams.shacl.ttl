dams:ITSolution a sh:NodeShape ;
    rdfs:comment "ИТ-решение, объединяющее одну или несколько ИТ-систем; мастер данных — EAM." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
