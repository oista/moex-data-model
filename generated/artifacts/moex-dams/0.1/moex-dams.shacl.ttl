dams:DataFlowEntityBinding a sh:NodeShape ;
    rdfs:comment "Связь потока с логическими сущностями, атрибутами и носителями данных модели решения." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:LogicalEntity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:logical_entity_ref ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
