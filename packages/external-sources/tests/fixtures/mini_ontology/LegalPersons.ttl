# Mini FIBO fixture for external-sources sync tests (ADR-017).
# Mirrors terms from packages/standard-owl/tests/fixtures/mini_fibo
# used by moex-fibo-profile (FND/BusinessDates + BE/LegalPersons).

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fibo-fnd-dt-bd: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/BusinessDates/> .
@prefix fibo-fnd-dt-oc: <https://spec.edmcouncil.org/fibo/ontology/FND/DatesAndTimes/Occurrences/> .
@prefix fibo-be-le-lp: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/LegalPersons/> .
@prefix fibo-be-le-fbo: <https://spec.edmcouncil.org/fibo/ontology/BE/LegalEntities/FormalBusinessOrganizations/> .

### FND / BusinessDates

fibo-fnd-dt-oc:OccurrenceKind a owl:Class ;
    rdfs:label "occurrence kind"@en .

fibo-fnd-dt-bd:BusinessDay a owl:Class ;
    rdfs:label "business day"@en ;
    rdfs:label "trading day"@en ;
    skos:definition "A day on which financial markets and banks are open for business."@en ;
    rdfs:subClassOf fibo-fnd-dt-oc:OccurrenceKind .

fibo-fnd-dt-bd:SettlementDay a owl:Class ;
    rdfs:label "settlement day"@en ;
    rdfs:subClassOf fibo-fnd-dt-bd:BusinessDay .

fibo-fnd-dt-bd:UnrelatedCalendarThing a owl:Class ;
    rdfs:label "unrelated calendar thing"@en .

### BE / LegalPersons

fibo-be-le-fbo:FormalOrganization a owl:Class ;
    rdfs:label "formal organization"@en .

fibo-be-le-lp:LegalPerson a owl:Class ;
    rdfs:label "legal person"@en ;
    skos:definition "An autonomous entity that is capable of having rights and obligations."@en ;
    rdfs:subClassOf fibo-be-le-fbo:FormalOrganization .

fibo-be-le-lp:NaturalPerson a owl:Class ;
    rdfs:label "natural person"@en ;
    rdfs:subClassOf fibo-be-le-lp:LegalPerson .

fibo-be-le-lp:UnrelatedThing a owl:Class ;
    rdfs:label "unrelated"@en .
