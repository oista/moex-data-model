# Copy to .env next to docker-compose.yml. Do not commit .env.

MODEL_TAG=local
MOEX_VERSION=0.1.0
GIT_SHA=
DEPS_FINGERPRINT=

MOEX_WEB_PORT=8080
MOEX_API_HOST=0.0.0.0
MOEX_API_PORT=8000

# Absolute path inside the container. Four slashes: sqlite:////data/...
MOEX_DATABASE_URL=sqlite:////data/moex_api.sqlite

# dev accepts X-Moex-Actor from the browser.
# trusted-header trusts the name nginx sets after auth_basic.
# Do not publish port 8000. With trusted-header the web container
# exits until auth/htpasswd exists:
#   printf 'user:%s\n' "$(openssl passwd -apr1)" >> auth/htpasswd
MOEX_AUTH_MODE=dev
MOEX_AUTH_HEADER=X-Remote-User

# local reads and writes the models working tree.
# gitlab opens a branch and a merge request (token needs api scope).
MOEX_GIT_PROVIDER=local
MOEX_GITLAB_URL=
MOEX_GITLAB_PROJECT=
MOEX_GITLAB_TOKEN=
MOEX_GITLAB_BASE=main
MOEX_GITLAB_CA_BUNDLE=

# Empty URL: models-sync does not fetch. Use docker/docker-compose.local.yml
# or a volume that already holds model-assets/, generated/, and packages/ontology/.
MOEX_MODELS_GIT_URL=
MOEX_MODELS_GIT_REF=main
MOEX_MODELS_DEPLOY_USER=
MOEX_MODELS_DEPLOY_TOKEN=
MOEX_MODELS_SYNC_INTERVAL=300
