@prefix dams: <https://data.moex.com/dams/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dams:HasBusinessClassification a sh:NodeShape ;
    rdfs:comment "Классификация роли и бизнес-значимости логической сущности." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "reference_data" "master_data" "transactional_data" "analytical_data" "metadata" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path dams:data_class ],
        [ sh:in ( "high" "medium" "low" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:business_importance ],
        [ sh:in ( "core" "derived" "reference" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:entity_type ] ;
    sh:targetClass dams:HasBusinessClassification .

dams:HasGovernanceClassification a sh:NodeShape ;
    rdfs:comment "Базовая и специальная классификация чувствительности данных." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 0 ;
            sh:path dams:governance_classification ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:classification_rationale ],
        [ sh:class dams:DataClassificationTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:sensitivity_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:classification_source ] ;
    sh:targetClass dams:HasGovernanceClassification .

dams:HasLifecycle a sh:NodeShape ;
    rdfs:comment "Mixin жизненного цикла: статус, период действия и ссылка на заменяющий элемент." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 0 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:valid_from ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:valid_to ] ;
    sh:targetClass dams:HasLifecycle .

dams:HasOwnership a sh:NodeShape ;
    rdfs:comment "Mixin владения: data owner, data steward и организационное подразделение." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:owning_unit_ref ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:data_owner_ref ] ;
    sh:targetClass dams:HasOwnership .

dams:HasPolicyBindings a sh:NodeShape ;
    rdfs:comment "Mixin привязки управляемых политик к элементу модели." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:Policy ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:policy_refs ] ;
    sh:targetClass dams:HasPolicyBindings .

dams:HasProvenance a sh:NodeShape ;
    rdfs:comment "Mixin происхождения и согласования: исходный артефакт, evidence, статус и согласующий." ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:evidence_refs ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path dams:approval_status ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:approved_by_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:source_artifact_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:approved_at ] ;
    sh:targetClass dams:HasProvenance .

dams:MOEXModelRepository a sh:NodeShape ;
    rdfs:comment "Корневой контейнер для проверки набора моделей, ссылочных проекций справочников, потоков и контрактных bindings." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:ModelPackage ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:model_packages ],
        [ sh:class dams:RegistryEntry ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:registry_entries ],
        [ sh:class dams:PolicyBinding ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:policy_bindings ],
        [ sh:class dams:Metric ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:metrics ],
        [ sh:class dams:DataModelBinding ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:data_model_bindings ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:repository_id ],
        [ sh:class dams:Dimension ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:dimensions ],
        [ sh:class dams:DataFlow ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:data_flows ],
        [ sh:class dams:ClassificationAssignment ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:classification_assignments ] ;
    sh:targetClass dams:MOEXModelRepository .

dams:ModelElement a sh:NodeShape ;
    rdfs:comment "Абстрактный корень иерархии элементов модели: общая идентичность (element_id), имя, описание и жизненный цикл." ;
    sh:closed false ;
    sh:ignoredProperties ( dams:native_type dams:transformation_ref dams:target_max_cardinality dams:source_solution_ref dams:entity_type dams:source_max_cardinality dams:evidence_refs dams:mapping_type dams:business_importance dams:requirement_level dams:model_package_ref dams:target_role dams:confidence dams:target_refs dams:ordinal_position dams:native_schema_ref dams:format_pattern dams:technology dams:imports_refs dams:required dams:approval_status dams:identifying dams:contract_ref dams:integration_spec_ref dams:transformation_expression dams:data_steward_ref dams:native_name rdf:type dams:metric_expression dams:domain_ref dams:conceptual_entities dams:source_artifact_ref dams:logical_entity_ref dams:default_value dams:selected_attributes dams:data_class dams:owner_entity_ref dams:physical_fields dams:approved_at dams:source_system_ref dams:context_ref dams:value_set_ref dams:compatibility_baseline_ref dams:associative dams:integration_level dams:source_refs dams:conceptual_entity_refs dams:physical_object_ref dams:target_min_cardinality dams:implementation_version dams:sensitivity_term_refs dams:logical_type dams:governance_classification dams:transformation_mapping_refs dams:source_platform_ref dams:generated_at dams:physical_object_refs dams:classification_source dams:code dams:owning_unit_ref dams:system_ref dams:selected_entities dams:transformation_mapping_ref dams:source_role dams:domain_contexts dams:unit dams:integration_ref dams:flow_ref dams:maximum_cardinality dams:classification_rationale dams:dimension_attribute_refs dams:target_system_ref dams:domain_refs dams:minimum_cardinality dams:derived_expression dams:approved_by_ref dams:aggregation_function dams:requirement_section dams:entity_bindings dams:source_min_cardinality dams:relationships dams:mappings dams:api_version dams:invariant_refs dams:logical_attribute_ref dams:qualified_name dams:source_model_ref dams:filter_expression dams:selections dams:direction dams:physical_field_refs dams:compatibility_mode dams:target_platform_ref dams:model_version dams:logical_entities dams:solution_data_role dams:target_solution_ref dams:mapping_cardinality dams:integration_channel dams:specification_version dams:source_entity_ref dams:namespace dams:logical_attribute_refs dams:target_entity_ref dams:model_revision dams:schema_path dams:grain_entity_refs dams:attributes dams:solution_ref dams:measure_attribute_refs dams:formal_checks dams:integration_class dams:object_kind dams:physical_objects dams:key_attribute_refs dams:policy_refs dams:data_owner_ref dams:multivalued dams:parent_concept_ref dams:integrity_digest dams:business_process_refs dams:statement ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:title ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:name ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:aliases ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:tags ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:glossary_term_refs ] ;
    sh:targetClass dams:ModelElement .

dams:RequirementCatalog a sh:NodeShape ;
    rdfs:comment "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:SpecificationRequirement ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:requirements ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:name ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:catalog_id ] ;
    sh:targetClass dams:RequirementCatalog .

dams:BusinessProcess a sh:NodeShape ;
    rdfs:comment "Ссылка на бизнес-процесс или его шаг в BPMN-репозитории." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:source_uri ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:registry_id ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dams:registry_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:master_system ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:registry_name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:registry_description ] ;
    sh:targetClass dams:BusinessProcess .

dams:ClassificationAssignment a sh:NodeShape ;
    rdfs:comment "Версионируемое назначение категории классификации элементу модели с основанием и периодом действия." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:classification_source ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:classification_rationale ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:assignment_id ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:valid_from ],
        [ sh:in ( "public" "internal" "confidential" "restricted" ) ;
            sh:maxCount 1 ;
            sh:order 3 ;
            sh:path dams:governance_classification ],
        [ sh:in ( "proposed" "approved" "rejected" "superseded" ) ;
            sh:maxCount 1 ;
            sh:order 8 ;
            sh:path dams:approval_status ],
        [ sh:class dams:DataClassificationTerm ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:classification_term_ref ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:classified_element_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:valid_to ] ;
    sh:targetClass dams:ClassificationAssignment .

dams:DataFlowEntityBinding a sh:NodeShape ;
    rdfs:comment "Связь потока с логическими сущностями, атрибутами и физическими объектами модели решения." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dams:PhysicalObject ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:physical_object_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dams:valid_from ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dams:aliases ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 15 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:description ],
        [ sh:class dams:LogicalEntity ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:logical_entity_ref ],
        [ sh:class dams:Mapping ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dams:transformation_mapping_refs ],
        [ sh:class dams:DataFlow ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:flow_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dams:element_id ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:PhysicalField ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path dams:physical_field_refs ],
        [ sh:in ( "inbound" "outbound" "internal" "bidirectional" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 7 ;
            sh:path dams:direction ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:source_model_ref ],
        [ sh:class dams:LogicalAttribute ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:logical_attribute_refs ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dams:valid_to ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dams:name ] ;
    sh:targetClass dams:DataFlowEntityBinding .

dams:DataModelBinding a sh:NodeShape ;
    rdfs:comment "Дочерняя модельная спецификация дата-контракта, фиксирующая неизменяемую ревизию модели и передаваемый срез." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dams:name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:model_version ;
            sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dams:tags ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path dams:title ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path dams:glossary_term_refs ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path dams:data_owner_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dams:valid_from ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 12 ;
            sh:path dams:lifecycle_status ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dams:element_id ],
        [ sh:class dams:OrganizationUnit ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dams:owning_unit_ref ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dams:compatibility_baseline_ref ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:generated_at ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dams:aliases ],
        [ sh:class dams:Role ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path dams:data_steward_ref ],
        [ sh:class dams:DataContractReference ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:contract_ref ],
        [ sh:class dams:IntegrationReference ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dams:integration_ref ],
        [ sh:in ( "backward" "forward" "full" "none" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 8 ;
            sh:path dams:compatibility_mode ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dams:implementation_version ;
            sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:integrity_digest ;
            sh:pattern "^sha256:[a-fA-F0-9]{64}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:specification_version ;
            sh:pattern "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path dams:model_package_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:model_revision ],
        [ sh:class dams:ModelSelection ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:selections ] ;
    sh:targetClass dams:DataModelBinding .

dams:Dimension a sh:NodeShape ;
    rdfs:comment "Переиспользуемое аналитическое измерение, связанное с логическими атрибутами." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dams:deprecated_by_ref ],
        [ sh:class dams:GlossaryTerm ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dams:glossary_term_refs ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dams:tags ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dams:valid_to ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dams:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:name ],
        [ sh:class dams:LogicalAttribute ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dams:dimension_attribute_refs ],
        [ sh:class dams:LogicalEntity ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path dams:grain_entity_refs ],
        [ sh:in ( "draft" "active" "deprecated" "retired" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 9 ;
            sh:path dams:lifecycle_status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:title ],
        [ sh:datatype xsd:string ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:aliases ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path dams:element_id ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dams:valid_from ] ;
    sh:targetClass dams:Dimension .

dams:FormalCheck a sh:NodeShape ;
    rdfs:comment "Одна машиночитаемая проверка требования. Kind выровнен с LinkML constraints и DAMS reference/structural diagnostics; assess wiring может появиться позже." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:in ( "error" "warning" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 5 ;
            sh:path dams:severity ],
        [ sh:datatype xsd:string ;
            sh:description "Мост к DAMS-STRUCT-* / DAMS-REF-* / будущим DAMS-REQ-*." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dams:diagnostic_code ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dams:target_slot ],
        [ sh:datatype xsd:string ;
            sh:description "Имя класса LinkML (например LogicalEntity)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dams:target_class ],
        [ sh:datatype xsd:string ;
            sh:description "JSON Pointer или path hint в теле ModelPackage." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dams:target_path ],
        [ sh:datatype xsd:string ;
            sh:description "Свободная LinkML-ish заметка при kind=custom." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dams:expression ],
        [ sh:in ( "slot_required" "slot_min_cardinality" "ref_resolves" "key_subset" "custom" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path dams:kind ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dams:check_id ] ;
    sh:targetClass dams:FormalCheck .

dams:Metric a sh:NodeShape ;
    rdfs:comment "Управляемое определение бизнес- или технической метрики; является опциональным аналитическим профилем." ;
