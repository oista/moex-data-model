dams:ClassificationAssignment a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ClassificationAssignment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approval_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_from ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:assignment_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:classification_term_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:classification_rationale ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_to ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:classified_element_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:governance_classification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:classification_source ] ;
    skos:definition "Версионируемое назначение категории классификации элементу модели с основанием и периодом действия." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:FormalCheck a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "FormalCheck" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:expression ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:check_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:diagnostic_code ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_slot ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_path ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:target_class ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:severity ] ;
    skos:definition "Одна машиночитаемая проверка требования. Kind выровнен с LinkML constraints и DAMS reference/structural diagnostics; assess wiring может появиться позже." ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

dams:HasProvenance a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "HasProvenance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approval_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approved_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approved_by_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:source_artifact_ref ] ;
    skos:definition "Mixin происхождения и согласования: исходный артефакт, evidence, статус и согласующий." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

dams:PolicyBinding a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PolicyBinding" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_from ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:policy_target_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:valid_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dams:approval_status ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:policy_ref ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:policy_binding_id ] ;
    skos:definition "Применение управляемой политики к элементу модели." ;
    skos:inScheme <https://data.moex.com/dams/governance/v0.1> .

