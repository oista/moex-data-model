@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dams:MOEXModelRepository a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "MOEXModelRepository" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:repository_id ] ;
    skos:definition "Корневой контейнер для проверки набора моделей, ссылочных проекций справочников, потоков и контрактных bindings." ;
    skos:inScheme dams:v0.1 .

dams:RequirementCatalog a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RequirementCatalog" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:catalog_id ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty dams:name ] ;
    skos:definition "Контейнер инстансов SpecificationRequirement вне ModelPackage." ;
    skos:inScheme <https://data.moex.com/dams/requirements/v0.1> .

