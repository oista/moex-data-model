<!DOCTYPE html>
<html lang="en" data-theme="light" data-viewer-version="2" data-density="comfortable">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Data Specification Player</title>
  {% if inline_css %}
  <style id="viewer-css">{{ inline_css | safe }}</style>
  {% else %}
  <link rel="stylesheet" href="viewer.css" />
  {% endif %}
</head>
<body>
  <div class="app" data-ui="app">
    {% include "sidebar.html.j2" %}
    <div class="main" data-ui="main">
      {% include "topbar.html.j2" %}
      {% include "content.html.j2" %}
    </div>
  </div>
  {% include "components/search-dialog.html.j2" %}
  <div class="status-region" id="status-region" role="status" aria-live="polite"></div>

  <script id="publication-data" type="application/json">{{ modules_json | safe }}</script>
  <script id="architecture-catalog" type="application/json">{{ catalog_json | safe }}</script>
  <script id="search-index" type="application/json">{{ search_index_json | safe }}</script>
  <script id="viewer-config" type="application/json">{{ viewer_config_json | safe }}</script>
  {% if inline_js %}
  <script id="viewer-js">{{ inline_js | safe }}</script>
  {% else %}
  <script src="viewer.js"></script>
  {% endif %}
</body>
</html>
