  {
    "id": "group:fibo-patterns",
    "title": "IRI and prefixes",
    "description": "FIBO IRI and namespace prefix templates.",
    "attributes": {
      "kind": "group",
      "section_root": "patterns",
      "purpose": "Canonical IRI and prefix patterns from ONTOLOGY_GUIDE.",
      "member_ids": [
        "iri:resource-iri",
        "iri:version-iri",
        "prefix:fibo-prefix"
      ]
    },
    "children": [
      {
        "id": "iri:resource-iri",
        "title": "Resource IRI",
        "description": "Non-versioned resource IRI pattern.",
        "attributes": {
          "kind": "iri_pattern",
          "template": "https://spec.edmcouncil.org/fibo/ontology/<domain>/<module>/.../<ontology>/<resource>"
        }
      },
      {
        "id": "iri:version-iri",
        "title": "Version IRI",
        "description": "Version IRI revised with agreed ontology changes.",
        "attributes": {
          "kind": "iri_pattern",
          "template": "https://spec.edmcouncil.org/fibo/ontology/<domain>/YYYYMMDD/<module>/.../<ontology>/"
        }
      },
      {
        "id": "prefix:fibo-prefix",
        "title": "Namespace prefix",
        "description": "Lower-case alpha segments separated by dashes.",
        "attributes": {
          "kind": "prefix_pattern",
          "template": "fibo-<domain>-<module>-...-<ontology>"
        }
      }
    ]
  },
  {
    "id": "group:fibo-annotations",
    "title": "Annotation profile",
    "description": "Required ontology header and element annotations.",
    "attributes": {
      "kind": "group",
      "section_root": "annotations",
      "purpose": "Minimum metadata for published FIBO ontologies and elements.",
      "member_ids": [
        "ann:onto-label",
        "ann:onto-abstract",
        "ann:onto-license",
        "ann:onto-copyright",
        "ann:element-label",
        "ann:element-definition"
      ]
    },
    "children": [
      {
        "id": "ann:onto-label",
        "title": "rdfs:label",
        "description": "Spelled-out English name of the ontology.",
        "attributes": {
          "kind": "annotation_requirement",
          "applies_to": "ontology_header",
          "required": true
        }
      },
      {
        "id": "ann:onto-abstract",
        "title": "dct:abstract",
        "description": "Short description of the ontology.",
        "attributes": {
          "kind": "annotation_requirement",
          "applies_to": "ontology_header",
          "required": true
        }
      },
      {
        "id": "ann:onto-license",
        "title": "dct:license",
        "description": "License (FIBO uses MIT).",
        "attributes": {
          "kind": "annotation_requirement",
          "applies_to": "ontology_header",
          "required": true
        }
      },
      {
        "id": "ann:onto-copyright",
        "title": "sm:copyright",
        "description": "Copyright statement (EDM Council / OMG as applicable).",
        "attributes": {
          "kind": "annotation_requirement",
          "applies_to": "ontology_header",
          "required": true
        }
      },
      {
        "id": "ann:element-label",
        "title": "rdfs:label",
        "description": "Natural-language label for every class, property, and individual.",
        "attributes": {
          "kind": "annotation_requirement",
          "applies_to": "element",
          "required": true
        }
      },
      {
        "id": "ann:element-definition",
        "title": "skos:definition",
        "description": "ISO 704-style definition (not rdfs:comment for first-class elements).",
        "attributes": {
          "kind": "annotation_requirement",
          "applies_to": "element",
          "required": true
        }
      }
    ]
  }
]
